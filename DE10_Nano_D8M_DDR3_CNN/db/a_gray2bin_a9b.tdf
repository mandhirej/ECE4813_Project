--synthesis_resources = 
SUBDESIGN a_gray2bin_a9b
( 
	bin[2..0]	:	output;
	gray[2..0]	:	input;
) 
VARIABLE 
	xor0	: WIRE;
	xor1	: WIRE;

BEGIN 
	bin[] = ( gray[2..2], xor1, xor0);
	xor0 = (gray[0..0] $ xor1);
	xor1 = (gray[2..2] $ gray[1..1]);
END;
--VALID FILE
