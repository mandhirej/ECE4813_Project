FUNCTION a_dpfifo_f471 (aclr, clock, data[21..0], rreq, sclr, wreq)
RETURNS ( empty, full, q[21..0], usedw[0..0]);

--synthesis_resources = lut 3 M10K 1 reg 6 
SUBDESIGN scfifo_tcd1
( 
	aclr	:	input;
	almost_empty	:	output;
	almost_full	:	output;
	clock	:	input;
	data[21..0]	:	input;
	empty	:	output;
	full	:	output;
	q[21..0]	:	output;
	rdreq	:	input;
	usedw[0..0]	:	output;
	wrreq	:	input;
) 
VARIABLE 
	dpfifo : a_dpfifo_f471;
	dffe_af : dffe;
	comparison_af0	: WIRE;
	comparison_pre_af0	: WIRE;
	sclr	: NODE;
	wire_af[0..0]	: WIRE;
	wire_pre_af[0..0]	: WIRE;

BEGIN 
	dpfifo.aclr = aclr;
	dpfifo.clock = clock;
	dpfifo.data[] = data[];
	dpfifo.rreq = rdreq;
	dpfifo.sclr = sclr;
	dpfifo.wreq = wrreq;
	dffe_af.clk = clock;
	dffe_af.clrn = (! aclr);
	dffe_af.d = ((dffe_af.q & (dffe_af.q $ (sclr # ((comparison_af0 & (! wrreq)) & rdreq)))) # ((! dffe_af.q) & (((! sclr) & comparison_pre_af0) & wrreq)));
	almost_empty = (! dpfifo.full);
	almost_full = dffe_af.q;
	comparison_af0 = (dpfifo.usedw[0..0] $ wire_af[0..0]);
	comparison_pre_af0 = (dpfifo.usedw[0..0] $ wire_pre_af[0..0]);
	empty = dpfifo.empty;
	full = dpfifo.full;
	q[] = dpfifo.q[];
	sclr = GND;
	usedw[] = dpfifo.usedw[];
	wire_af[] = ( B"0");
	wire_pre_af[] = ( B"1");
END;
--VALID FILE
