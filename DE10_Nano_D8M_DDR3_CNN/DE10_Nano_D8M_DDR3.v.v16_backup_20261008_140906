      3'd0: case(r)0:suit_row=16'b0000011100000000;1,2:suit_row=16'b0000111110000000;3:suit_row=16'b0011101110111000;4,5:suit_row=16'b0111111111111100;6:suit_row=16'b0011111111111000;7:suit_row=16'b0000111110000000;8,9,10:suit_row=16'b0000011100000000;11:suit_row=16'b0000111110000000;12:suit_row=16'b0001111111000000;default:suit_row=0;endcase
    endcase
 end endfunction
 reg [4:0] bits;
 reg [7:0] ch;
 reg [3:0] hun,ten,one;
 always @* begin
   color=BG;ink=LIGHT;frame=MUTED;line="                            ";tx=0;ty=0;zoom=0;text_on=0;
   row=0;col=0;lx=0;ly=0;idx=0;cls=0;state=0;dx=0;dy=0;ci=0;gx=0;gy=0;ch=" ";bits=0;
   target_cls=cards[ui_target_cell*6 +: 6];shade_suit=0;textrow=0;pxs=0;pys=0;suit_bits=0; hun=turn_number/100;ten=(turn_number/10)%10;one=turn_number%10;
   if(x>=8&&x<272&&y>=28&&y<258)color=24'h1C2B43;
   if(x>=280&&x<472&&y>=8&&y<151)color=PANEL;
   if(x>=280&&x<282&&y>=8&&y<151)color=ORANGE;
   if(x>=280&&x<472&&y>=142&&y<264)color=PANEL;
   if(x>=287&&x<469&&y>=155&&y<259)color=24'h0A1222;
   if(x<276&&y>=9&&y<23)begin tx=12;ty=9;zoom=1;line="SUIT STACK RACE         ";text_on=1;ink=LIGHT;end
   if(x<276&&y>=23&&y<30)begin tx=24;ty=23;line="D      C      H      S  ";text_on=1;ink=CYAN;end
   if(x>=12&&x<268&&y>=32&&y<256)begin
      col=(x-12)>>6;lx=(x-12)&63;
      if(y<88)begin row=0;ly=y-32;end else if(y<144)begin row=1;ly=y-88;end else if(y<200)begin row=2;ly=y-144;end else begin row=3;ly=y-200;end
      idx=row*4+col;cls=cards[idx*6 +: 6];state=states[idx*2 +: 2];
      if(lx>=1&&lx<57&&ly>=2&&ly<54)color=24'h080F20;
      if(lx<56&&ly<52)begin
        if(state==0)frame=24'h53677F;else if(state==1)frame=ORANGE;
        else if(state==2)frame=MAGENTA;else frame=GREEN;
        // Pulsing target outline: no HPS polling needed for animation.
        if((state==1) && blink_cnt[24])frame=24'hFFF4A4;
        color=frame;
        if(lx>0&&lx<55&&ly>0&&ly<51)begin
          color=(state==0)?24'h24354D:24'hFFF0F4;
          if(state==0 && ((lx+ly)&7)==0)color=24'h334762;
          if(state!=0)begin
            shade_suit=(cls==44||cls==45)?3'd4:
              ((cls<=43)?{1'b0,cls[1:0]}:((cls<=49)?(cls-46)&3:(cls-50)&3));
            // Large 16x15 physical suit artwork centred in each card.
            if(lx>=19&&lx<35&&ly>=22&&ly<37&&shade_suit<4)begin
              pxs=lx-19;pys=ly-22;suit_bits=suit_row(shade_suit,pys[3:0]);
              if(suit_bits[15-pxs])color=(shade_suit==1||shade_suit==2)?24'hDE254F:24'h101820;
            end
            // Four pip pattern accents echo the old HDMI card design.
            if(lx>=10&&lx<26&&ly>=35&&ly<50&&shade_suit<4)begin
              pxs=lx-10;pys=ly-35;suit_bits=suit_row(shade_suit,pys[3:0]);
              if(suit_bits[15-pxs])color=(shade_suit==1||shade_suit==2)?24'hE75678:24'h233147;
            end
            if(state==2 && ly>=18&&ly<32)begin tx=col*64+23;ty=row*56+52;zoom=1;line="JOKER                       ";text_on=1;ink=MAGENTA;end
            else if(ly>=5&&ly<19)begin
              tx=col*64+20;ty=row*56+37;zoom=1;
              line="                            ";
              line[223 -: 8]=rank1(cls);line[215 -: 8]=rank2(cls);line[207 -: 8]=suit_ascii(cls);
              text_on=1;ink=(shade_suit==1||shade_suit==2)?RED:INK;
            end
          end
          if(ly>=42)begin
            color=frame;ink=INK;text_on=1;zoom=0;
            ty=row*56+76;tx=col*64+15;line="D1                          ";
            line[223 -: 8]=col_ascii(col[1:0]);line[215 -: 8]=digit_ascii(row+1);
          end
        end
      end
   end
   if(x>=276)begin
      text_on=1;tx=288;ink=LIGHT;
      if(y>=12&&y<24)begin ty=12;zoom=1;line="SUIT STACK RACE             ";ink=ORANGE;end
      else if(y>=30&&y<37)begin ty=30;line="JOKERS  LEFT    ROUND        ";ink=CYAN;end
      else if(y>=40&&y<47)begin
        ty=40;line="0        00      000         ";
        line[223 -:8]=digit_ascii(score);
        line[223-9*8 -:8]=remaining_cards>=10?"1":"0";
        line[223-10*8 -:8]=digit_ascii(remaining_cards>=10?remaining_cards-10:remaining_cards);
        line[223-18*8 -:8]=digit_ascii(hun);
        line[223-19*8 -:8]=digit_ascii(ten);
        line[223-20*8 -:8]=digit_ascii(one);
      end
      else if(y>=52&&y<59)begin ty=52;line="ACTION / NEXT STEP          ";ink=CYAN;end
      else if(y>=62&&y<108)begin
        textrow=(y-62)/9;
        if((y-62)%9<7&&textrow<5)begin
           tx=287;ty=62+textrow*9;line=ui_text[1791-textrow*224 -:224];
           ink=(textrow==0)?ORANGE:LIGHT;
        end else text_on=0;
      end
      else if(y>=110&&y<117)begin ty=110;line="SYSTEM / DEBUG LOG          ";ink=CYAN;end
      else if(y>=119&&y<146)begin
        textrow=5+(y-119)/9;
        if((y-119)%9<7&&textrow<8)begin
           tx=287;ty=119+(textrow-5)*9;line=ui_text[1791-textrow*224 -:224];ink=MUTED;
        end else text_on=0;
      end
      else text_on=0;
   end
   dx=x-tx;dy=y-ty;
   if(text_on&&dx>=0&&dy>=0)begin ci=(dx>>zoom)/6;gx=(dx>>zoom)%6;gy=dy>>zoom;if(ci<28&&gx<5&&gy<7)begin ch=line[223-ci*8 -: 8];bits=font5x7_row(ch,gy);if(bits[4-gx])color=ink;end end
 end
 always @(posedge clk)if(enable)rgb<={color[23:19],color[15:10],color[7:3]};
endmodule

