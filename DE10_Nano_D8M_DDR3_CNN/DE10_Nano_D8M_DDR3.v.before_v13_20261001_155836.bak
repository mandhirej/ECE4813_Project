`default_nettype wire


module DE10_Nano_D8M_DDR3(

	//////////// ADC //////////
	output		          		ADC_CONVST,
	output		          		ADC_SCK,
	output		          		ADC_SDI,
	input 		          		ADC_SDO,

	//////////// ARDUINO //////////
	inout 		    [15:0]		ARDUINO_IO,
	inout 		          		ARDUINO_RESET_N,

	//////////// CLOCK //////////
	input 		          		FPGA_CLK1_50,
	input 		          		FPGA_CLK2_50,
	input 		          		FPGA_CLK3_50,

	//////////// HDMI //////////
	inout 		          		HDMI_I2C_SCL,
	inout 		          		HDMI_I2C_SDA,
	inout 		          		HDMI_I2S,
	inout 		          		HDMI_LRCLK,
	inout 		          		HDMI_MCLK,
	inout 		          		HDMI_SCLK,
	output		          		HDMI_TX_CLK,
	output		          		HDMI_TX_DE,
	output		    [23:0]		HDMI_TX_D,
	output		          		HDMI_TX_HS,
	input 		          		HDMI_TX_INT,
	output		          		HDMI_TX_VS,

	//////////// HPS //////////
	inout 		          		HPS_CONV_USB_N,
	output		    [14:0]		HPS_DDR3_ADDR,
	output		     [2:0]		HPS_DDR3_BA,
	output		          		HPS_DDR3_CAS_N,
	output		          		HPS_DDR3_CKE,
	output		          		HPS_DDR3_CK_N,
	output		          		HPS_DDR3_CK_P,
	output		          		HPS_DDR3_CS_N,
	output		     [3:0]		HPS_DDR3_DM,
	inout 		    [31:0]		HPS_DDR3_DQ,
	inout 		     [3:0]		HPS_DDR3_DQS_N,
	inout 		     [3:0]		HPS_DDR3_DQS_P,
	output		          		HPS_DDR3_ODT,
	output		          		HPS_DDR3_RAS_N,
	output		          		HPS_DDR3_RESET_N,
	input 		          		HPS_DDR3_RZQ,
	output		          		HPS_DDR3_WE_N,
	output		          		HPS_ENET_GTX_CLK,
	inout 		          		HPS_ENET_INT_N,
	output		          		HPS_ENET_MDC,
	inout 		          		HPS_ENET_MDIO,
	input 		          		HPS_ENET_RX_CLK,
	input 		     [3:0]		HPS_ENET_RX_DATA,
	input 		          		HPS_ENET_RX_DV,
	output		     [3:0]		HPS_ENET_TX_DATA,
	output		          		HPS_ENET_TX_EN,
	inout 		          		HPS_GSENSOR_INT,
	inout 		          		HPS_I2C0_SCLK,
	inout 		          		HPS_I2C0_SDAT,
	inout 		          		HPS_I2C1_SCLK,
	inout 		          		HPS_I2C1_SDAT,
	inout 		          		HPS_KEY,
	inout 		          		HPS_LED,
	inout 		          		HPS_LTC_GPIO,
	output		          		HPS_SD_CLK,
	inout 		          		HPS_SD_CMD,
	inout 		     [3:0]		HPS_SD_DATA,
	output		          		HPS_SPIM_CLK,
	input 		          		HPS_SPIM_MISO,
	output		          		HPS_SPIM_MOSI,
	inout 		          		HPS_SPIM_SS,
	input 		          		HPS_UART_RX,
	output		          		HPS_UART_TX,
	input 		          		HPS_USB_CLKOUT,
	inout 		     [7:0]		HPS_USB_DATA,
	input 		          		HPS_USB_DIR,
	input 		          		HPS_USB_NXT,
	output		          		HPS_USB_STP,

	//////////// KEY //////////
	input 		     [1:0]		KEY,

	//////////// LED //////////
	output		     [7:0]		LED,

	//////////// SW //////////
	input 		     [3:0]		SW,

	//////////// GPIO_0, GPIO connect to D8M-GPIO //////////
	inout 		          		CAMERA_I2C_SCL,
	inout 		          		CAMERA_I2C_SDA,
	output		          		CAMERA_PWDN_n,
	output		          		MIPI_CS_n,
	inout 		          		MIPI_I2C_SCL,
	inout 		          		MIPI_I2C_SDA,
	output		          		MIPI_MCLK,
	input 		          		MIPI_PIXEL_CLK,
	input 		     [9:0]		MIPI_PIXEL_D,
	input 		          		MIPI_PIXEL_HS,
	input 		          		MIPI_PIXEL_VS,
	output		          		MIPI_REFCLK,
	output		          		MIPI_RESET_n
);


parameter VIDEO_HEIGHT =16'd1080 ; 
parameter VIDEO_WIDTH  =16'd1920 ; 

//=======================================================
//  REG/WIRE declarations
//=======================================================

wire disp_hs;
wire disp_vs;
wire disp_de;
wire [7:0] disp_r;
wire [7:0] disp_g;
wire [7:0] disp_b;

// RGB after the existing autofocus/display processing.  These signals are
// overlaid with the CNN result before being sent to the HDMI transmitter.
wire [7:0] focus_r;
wire [7:0] focus_g;
wire [7:0] focus_b;

// ---------------------------------------------------------------------------
// Registered HDMI/game branch.
// The CNN has a separate preserved register branch below.  Keeping these
// branches independent prevents the scaler/game compositor from sharing the
// CNN input registers.
// ---------------------------------------------------------------------------
reg        video_hs_pipe;
reg        video_vs_pipe;
reg        video_de_pipe;
reg [7:0]  video_r_pipe;
reg [7:0]  video_g_pipe;
reg [7:0]  video_b_pipe;

// Display V9 uses RGB and timing from the same registered CVO source.

// ---------------------------------------------------------------------------
// Dedicated CNN video branch.
// ---------------------------------------------------------------------------
// These registers are intentionally NOT shared with the HDMI scaler/game path.
// The cropper/CNN receives only this branch.  The preserve attribute discourages
// Quartus from merging these registers back into the display pipeline.
(* preserve *) reg        cnn_hs_pipe;
(* preserve *) reg        cnn_vs_pipe;
(* preserve *) reg        cnn_de_pipe;
(* preserve *) reg [7:0]  cnn_r_pipe;
(* preserve *) reg [7:0]  cnn_g_pipe;
(* preserve *) reg [7:0]  cnn_b_pipe;

wire  RESET_N;
wire  RESET_N_DELAY  ; 

wire  I2C_RELEASE;
wire  VCM_RELAESE;
wire  HDMI_CLK;
wire  READY;

wire  D8M_CK_HZ;
wire  D8M_CK_HZ2;
wire  D8M_CK_HZ3;

wire  AUTO_FOC ;

//=======================================================
//  Structural coding
//=======================================================
// HDMI pixel clock remains unchanged. RGB/DE/HS/VS are registered together
// at the end of the compositor so all HDMI signals stay aligned.
assign HDMI_TX_CLK = ~HDMI_CLK; // sdc -invert

assign CAMERA_PWDN_n  = RESET_N; 
assign MIPI_CS_n      = 0 ; 
assign MIPI_RESET_n   = RESET_N; 

//<------------------------------------------
wire CAMERA_I2C_SCL_MIPI ; 
wire CAMERA_I2C_SCL_AF;

wire CAMERA_MIPI_RELAESE , MIPI_BRIDGE_RELEASE ; 

assign I2C_RELEASE = CAMERA_MIPI_RELAESE & MIPI_BRIDGE_RELEASE; 
assign CAMERA_I2C_SCL = ( I2C_RELEASE  )?  CAMERA_I2C_SCL_AF  : CAMERA_I2C_SCL_MIPI ;   
 




////---ALL RESET ---- 
//RESET_DELAY  d5(
//           .RESET_N      ( RESET_N ) ,
//           .CLK          ( FPGA_CLK2_50 ) , 
//           .READY        ( RESET_N_DELAY)  
//);  
 //------ MIPI BRIGE & CAMERA SETTING  --   
MIPI_BRIDGE_CAMERA_Config    cfin(
          .RESET_N           ( RESET_N_DELAY ), 
          .CLK_50            ( FPGA_CLK2_50 ), 
          .MIPI_I2C_SCL      ( MIPI_I2C_SCL ), 
          .MIPI_I2C_SDA      ( MIPI_I2C_SDA ), 
          .MIPI_I2C_RELEASE  ( MIPI_BRIDGE_RELEASE ),  
          .CAMERA_I2C_SCL    ( CAMERA_I2C_SCL_MIPI ),
          .CAMERA_I2C_SDA    ( CAMERA_I2C_SDA ),
          .CAMERA_I2C_RELAESE( CAMERA_MIPI_RELAESE ),
			 .VCM_RELAESE       ( VCM_RELAESE )
 );


////-- SYSTEM RESET 
//RESET_DELAY  del  (
// .RESET_N (KEY[0] ) ,
// .CLK     (FPGA_CLK3_50) , 
// .READY   ( RESET_N)  
//);


RESET_DELAY  dl(
           .RESET_N      ( KEY[0] ) ,
           .CLK          ( FPGA_CLK1_50) , 
           .READY0       ( RESET_N),
			  .READY1       ( RESET_N_DELAY ) 
); 

// One-stage timing isolation for the processed CVO video stream.
// Keep RGB and timing together so the CNN and preview see identical pixels.
always @(posedge HDMI_CLK or negedge RESET_N) begin
    if (!RESET_N) begin
        video_hs_pipe <= 1'b0;
        video_vs_pipe <= 1'b0;
        video_de_pipe <= 1'b0;
        video_r_pipe   <= 8'd0;
        video_g_pipe   <= 8'd0;
        video_b_pipe   <= 8'd0;

        cnn_hs_pipe <= 1'b0;
        cnn_vs_pipe <= 1'b0;
        cnn_de_pipe <= 1'b0;
        cnn_r_pipe  <= 8'd0;
        cnn_g_pipe  <= 8'd0;
        cnn_b_pipe  <= 8'd0;
    end else begin
        // HDMI/game branch.
        video_hs_pipe <= disp_hs;
        video_vs_pipe <= disp_vs;
        video_de_pipe <= disp_de;
        video_r_pipe  <= disp_r;
        video_g_pipe  <= disp_g;
        video_b_pipe  <= disp_b;

        // Dedicated CNN branch.  Nothing in the scaler/game renderer reads
        // these registers.
        cnn_hs_pipe <= disp_hs;
        cnn_vs_pipe <= disp_vs;
        cnn_de_pipe <= disp_de;
        cnn_r_pipe  <= disp_r;
        cnn_g_pipe  <= disp_g;
        cnn_b_pipe  <= disp_b;

        // Preview branch: colour-corrected/autofocus output only.
    end
end


//------AUTO FOCUS ENABLE  --
AUTO_FOCUS_ON  u9( 
          .CLK_50      ( FPGA_CLK3_50 ), 
          .I2C_RELEASE ( I2C_RELEASE ), 
          .AUTO_FOC    ( AUTO_FOC )
               ) ; 
//------AUTO FOCUS ADJ  --
FOCUS_ADJ adl(
          .CLK_50        ( FPGA_CLK3_50) , 
          .RESET_N       ( I2C_RELEASE ), 
          .RESET_SUB_N   ( I2C_RELEASE ), 
          .AUTO_FOC      ( KEY[1] & AUTO_FOC ),
          .SW_Y          ( 0 ),
          .SW_H_FREQ     ( 0 ),   
          .SW_FUC_LINE   ( SW[3] ),   
          .SW_FUC_ALL_CEN( SW[3] ), 
		

			 .VIDEO_DE      (disp_de) ,
			
          .VIDEO_HS      ( disp_hs),
          .VIDEO_VS      ( disp_vs),
          .VIDEO_CLK     ( HDMI_CLK),
          .iR            (disp_r),
          .iG            (disp_g),
          .iB            (disp_b),
			 
	       .oR            (focus_r ), 
       	 .oG            (focus_g), 
	       .oB            (focus_b), 
	
          .READY         ( READY),
          .SCL           ( CAMERA_I2C_SCL_AF ), 
          .SDA           ( CAMERA_I2C_SDA )
   
);  



//HDMI I2C
I2C_HDMI_Config u_I2C_HDMI_Config (
	.iCLK(FPGA_CLK2_50),
	.iRST_N(KEY[0]),
	.I2C_SCLK(HDMI_I2C_SCL),
	.I2C_SDAT(HDMI_I2C_SDA),
	.HDMI_TX_INT(HDMI_TX_INT)
	);

///////////////////////////////////////
reg         MIPI_PIXEL_VS_d;
reg         MIPI_PIXEL_HS_d;
reg   [9:0] MIPI_PIXEL_D_d;


always @ (posedge MIPI_PIXEL_CLK) begin
   MIPI_PIXEL_VS_d <= MIPI_PIXEL_VS;
   MIPI_PIXEL_HS_d <= MIPI_PIXEL_HS;
   MIPI_PIXEL_D_d  <= MIPI_PIXEL_D;
end

wire [7:0] bridge_test_out;
wire [7:0] bridge_test_in;
wire [7:0] CNN_status;

// V10 upload conduit: all signals below run on FPGA_CLK1_50.
wire hcnn_clear,hcnn_we,hcnn_start,hcnn_reset_n,hcnn_busy;
wire [11:0] hcnn_addr;
wire [7:0] hcnn_data;
wire [31:0] hcnn_hash;
wire [12:0] hcnn_count;
wire hcnn_bbox_valid;
wire [10:0] hcnn_min_x,hcnn_max_x,hcnn_min_y,hcnn_max_y;
wire [5:0] CNN_prediction;
wire CNN_done;

soc_system u0 (
    .cnn_upload_clk_clk(FPGA_CLK1_50),
    .cnn_upload_reset_reset(~RESET_N),
    .cnn_upload_pixel_clear(hcnn_clear),
    .cnn_upload_pixel_we(hcnn_we),
    .cnn_upload_pixel_addr(hcnn_addr),
    .cnn_upload_pixel_data(hcnn_data),
    .cnn_upload_start(hcnn_start),
    .cnn_upload_core_reset_n(hcnn_reset_n),
    .cnn_upload_core_busy(hcnn_busy),
    .cnn_upload_core_done(CNN_done),
    .cnn_upload_core_class(CNN_prediction),
    .cnn_upload_image_hash(hcnn_hash),
    .cnn_upload_image_count(hcnn_count),
    .cnn_upload_bbox_valid(hcnn_bbox_valid),
    .cnn_upload_bbox_min_x(hcnn_min_x),
    .cnn_upload_bbox_max_x(hcnn_max_x),
    .cnn_upload_bbox_min_y(hcnn_min_y),
    .cnn_upload_bbox_max_y(hcnn_max_y),

	//Clock&Reset
	.clk_clk                               ( FPGA_CLK3_50 ),                               //                            clk.clk
   .clk_hps_ref_clk                       (FPGA_CLK1_50),                             //                   pll_1_refclk.clk
   .clk_hdmi_ref_clk                      (FPGA_CLK2_50), 
	.reset_reset_n                         (1'b1),         

	
	//HPS ddr3
	.memory_mem_a                          ( HPS_DDR3_ADDR),                       //                memory.mem_a
	.memory_mem_ba                         ( HPS_DDR3_BA),                         //                .mem_ba
	.memory_mem_ck                         ( HPS_DDR3_CK_P),                       //                .mem_ck
	.memory_mem_ck_n                       ( HPS_DDR3_CK_N),                       //                .mem_ck_n
	.memory_mem_cke                        ( HPS_DDR3_CKE),                        //                .mem_cke
	.memory_mem_cs_n                       ( HPS_DDR3_CS_N),                       //                .mem_cs_n
	.memory_mem_ras_n                      ( HPS_DDR3_RAS_N),                      //                .mem_ras_n
	.memory_mem_cas_n                      ( HPS_DDR3_CAS_N),                      //                .mem_cas_n
	.memory_mem_we_n                       ( HPS_DDR3_WE_N),                       //                .mem_we_n
	.memory_mem_reset_n                    ( HPS_DDR3_RESET_N),                    //                .mem_reset_n
	.memory_mem_dq                         ( HPS_DDR3_DQ),                         //                .mem_dq
	.memory_mem_dqs                        ( HPS_DDR3_DQS_P),                      //                .mem_dqs
	.memory_mem_dqs_n                      ( HPS_DDR3_DQS_N),                      //                .mem_dqs_n
	.memory_mem_odt                        ( HPS_DDR3_ODT),                        //                .mem_odt
	.memory_mem_dm                         ( HPS_DDR3_DM),                         //                .mem_dm
	.memory_oct_rzqin                      ( HPS_DDR3_RZQ),                        //                .oct_rzqin
	//HPS SD card
	.hps_0_hps_io_hps_io_sdio_inst_CMD     ( HPS_SD_CMD    ),           //                               .hps_io_sdio_inst_CMD
	.hps_0_hps_io_hps_io_sdio_inst_D0      ( HPS_SD_DATA[0]     ),      //                               .hps_io_sdio_inst_D0
	.hps_0_hps_io_hps_io_sdio_inst_D1      ( HPS_SD_DATA[1]     ),      //                               .hps_io_sdio_inst_D1
	.hps_0_hps_io_hps_io_sdio_inst_CLK     ( HPS_SD_CLK   ),            //                               .hps_io_sdio_inst_CLK
	.hps_0_hps_io_hps_io_sdio_inst_D2      ( HPS_SD_DATA[2]     ),      //                               .hps_io_sdio_inst_D2
	.hps_0_hps_io_hps_io_sdio_inst_D3      ( HPS_SD_DATA[3]     ),      //                               .hps_io_sdio_inst_D3
	//HPS UART
	.hps_0_hps_io_hps_io_uart0_inst_RX     ( HPS_UART_RX   ),          //                               .hps_io_uart0_inst_RX
	.hps_0_hps_io_hps_io_uart0_inst_TX     ( HPS_UART_TX   ),          //                               .hps_io_uart0_inst_TX
	.hps_0_hps_io_hps_io_gpio_inst_GPIO53  ( HPS_LED   ),  //                               .hps_io_gpio_inst_GPIO53

	//D8M camera
	.terasic_camera_0_conduit_end_camera_d        ({MIPI_PIXEL_D_d[9:0], 2'b00}),               //   terasic_camera_0_conduit_end.D
	.terasic_camera_0_conduit_end_camera_fval     (MIPI_PIXEL_VS_d),            //                               .FVAL
	.terasic_camera_0_conduit_end_camera_lval     (MIPI_PIXEL_HS_d),            //                               .LVAL
	.terasic_camera_0_conduit_end_camera_pixclk   (MIPI_PIXEL_CLK),           //                               .PIXCLK
   
	
	//FPGA Partion
	 
        .alt_vip_cl_cvo_0_clocked_video_vid_clk          (HDMI_CLK),          //    alt_vip_itc_0_clocked_video.vid_clk
        .alt_vip_cl_cvo_0_clocked_video_vid_data         ({disp_r, disp_g, disp_b}),         //                               .vid_data
        .alt_vip_cl_cvo_0_clocked_video_vid_datavalid    (disp_de),    //                               .vid_datavalid
        .alt_vip_cl_cvo_0_clocked_video_vid_v_sync       (disp_vs),       //                               .vid_v_sync
        .alt_vip_cl_cvo_0_clocked_video_vid_h_sync       (disp_hs),       //                               .vid_h_sync
	 
	

	//clk for HDMI_TX_CLK
	.clk_hdmi_clk                                 (HDMI_CLK),
	//clk for MIPI_REFCLK
	.clk_d8m_clk                                  (MIPI_REFCLK),                                  //                        clk_d8m.clk
	
	.bridge_test_out_export(bridge_test_out),
   .bridge_test_in_export(bridge_test_in),
	.cnn_status_export(CNN_status)
`ifdef HPS_SNAPSHOT_ENABLE
    // Enable this macro only AFTER adding the supplied capture IP to Qsys.
    ,.snapshot_video_clk_clk(HDMI_CLK)
    ,.snapshot_video_r(video_r_pipe)
    ,.snapshot_video_g(video_g_pipe)
    ,.snapshot_video_b(video_b_pipe)
    ,.snapshot_video_vs(video_vs_pipe)
    ,.snapshot_video_de(video_de_pipe)
`endif
	);
	
//--LED DISPLAY--
CLOCKMEM  ck1 ( .CLK(HDMI_CLK),			.CLK_FREQ  (148500000 ), 	. CK_1HZ (D8M_CK_HZ   )  ) ;//148.5 MHZ
CLOCKMEM  ck2 ( .CLK(MIPI_REFCLK   ),	.CLK_FREQ  ( 20000000 ), 	. CK_1HZ (D8M_CK_HZ2  )  ) ;//20 MHZ
CLOCKMEM  ck3 ( .CLK(MIPI_PIXEL_CLK),	.CLK_FREQ  (100000000 ), 	. CK_1HZ (D8M_CK_HZ3  )  ) ;//100 MHZ

//assign LED[7:0] = {  D8M_CK_HZ, D8M_CK_HZ2, D8M_CK_HZ3, 2'h0,VCM_RELAESE, CAMERA_MIPI_RELAESE, MIPI_BRIDGE_RELEASE  } ; 

// ===========================================================
// CUSTOM CNN HARDWARE PIPELINE
// ===========================================================
wire       CNN_result_bbox_valid;
wire [10:0] CNN_result_bbox_min_x;
wire [10:0] CNN_result_bbox_max_x;
wire [10:0] CNN_result_bbox_min_y;
wire [10:0] CNN_result_bbox_max_y;

// ---------------------------------------------------------------------------
// CNN/CROPPER ISOLATION BOUNDARY
// ---------------------------------------------------------------------------
// From this point onward the CNN sees only cnn_*_pipe.  The ping-pong preview,
// card renderer, HPS game state, and final HDMI compositor cannot feed back
// into this branch.
cnn_accelerator_top CNN_core (
    .clk_50mhz(FPGA_CLK1_50),.reset_n(RESET_N & hcnn_reset_n),
    .pixel_clear(hcnn_clear),.pixel_we(hcnn_we),.pixel_addr(hcnn_addr),.pixel_data(hcnn_data),
    .start(hcnn_start),.busy(hcnn_busy),.image_hash(hcnn_hash),.image_count(hcnn_count),
    .bbox_valid(hcnn_bbox_valid),.bbox_min_x(hcnn_min_x),.bbox_max_x(hcnn_max_x),
    .bbox_min_y(hcnn_min_y),.bbox_max_y(hcnn_max_y),
    .predicted_class (CNN_prediction),
    .cnn_done        (CNN_done),
    .result_bbox_valid(CNN_result_bbox_valid),
    .result_bbox_min_x(CNN_result_bbox_min_x),
    .result_bbox_max_x(CNN_result_bbox_max_x),
    .result_bbox_min_y(CNN_result_bbox_min_y),
    .result_bbox_max_y(CNN_result_bbox_max_y)
);

// Show prediction on LED
reg [5:0] CNN_prediction_latched;
reg       CNN_bbox_valid_latched;
reg [10:0] CNN_bbox_min_x_latched;
reg [10:0] CNN_bbox_max_x_latched;
reg [10:0] CNN_bbox_min_y_latched;
reg [10:0] CNN_bbox_max_y_latched;
reg CNN_result_toggle;
reg CNN_result_valid;

always @(posedge FPGA_CLK1_50 or negedge RESET_N) begin
    if (!RESET_N) begin
        CNN_prediction_latched <= 6'd0;
        CNN_bbox_valid_latched <= 1'b0;
        CNN_bbox_min_x_latched <= 11'd0;
        CNN_bbox_max_x_latched <= 11'd0;
        CNN_bbox_min_y_latched <= 11'd0;
        CNN_bbox_max_y_latched <= 11'd0;
        CNN_result_toggle      <= 1'b0;
        CNN_result_valid       <= 1'b0;
    end
    else if (CNN_done) begin
        // Latch the class and the exact crop box as one result packet.
        CNN_prediction_latched <= CNN_prediction;
        CNN_bbox_valid_latched <= CNN_result_bbox_valid;
        CNN_bbox_min_x_latched <= CNN_result_bbox_min_x;
        CNN_bbox_max_x_latched <= CNN_result_bbox_max_x;
        CNN_bbox_min_y_latched <= CNN_result_bbox_min_y;
        CNN_bbox_max_y_latched <= CNN_result_bbox_max_y;
        CNN_result_toggle      <= ~CNN_result_toggle;
        CNN_result_valid       <= 1'b1;
    end
end



// ===========================================================================
// HPS-controlled 5-second capture window + shared command protocol
// ---------------------------------------------------------------------------
// bridge_test_out is a robust HPS command mailbox. Every LOGICAL command is
// written twice with identical opcode/payload and opposite raw sequence bits.
// FPGA executes only after both synchronized copies match:
//   bit 7     : raw physical-transfer toggle
//   bits 6:4  : opcode
//   bits 3:0  : payload nibble
//
// Opcodes used by the FPGA capture engine:
//   0 = START_CAPTURE, payload = board coordinate 0..15
// Other opcodes are consumed in the HDMI domain for board/game display state.
//
// bridge_test_in is both capture status and command acknowledgement:
//   while capture / majority scan is busy:
//     bit7=1, bits6:4=countdown, bit3=display ACK, bit2=link error
//   idle with capture result:
//     bit7=0, bit6=1, bits5:0=majority class
//   idle without capture result:
//     bit7=0, bit6=0, bit5=display ACK, bit4=link error
//
// Separating capture from board-state commit is deliberate: the HPS now owns
// the board coordinate/card/state relationship.  This removes the old
// capture-result CDC path that could, very rarely, associate a new result with
// the previously selected HDMI cell.
// ===========================================================================
localparam [2:0] GAME_CMD_CAPTURE     = 3'd0;
localparam [2:0] GAME_CMD_SELECT_CELL = 3'd1;
localparam [2:0] GAME_CMD_CLASS_LOW   = 3'd2;
localparam [2:0] GAME_CMD_CELL_COMMIT = 3'd3;
localparam [2:0] GAME_CMD_SCORE     = 3'd4;
localparam [2:0] GAME_CMD_TURN     = 3'd5;
localparam [2:0] GAME_CMD_CONTROL     = 3'd6;
localparam [2:0] GAME_CMD_RESET       = 3'd7;

localparam [27:0] GAME_CAPTURE_CYCLES = 28'd250000000; // 5 s @ 50 MHz
localparam [25:0] GAME_ONE_SEC_CYCLES = 26'd50000000;  // 1 s @ 50 MHz

// ---------------------------------------------------------------------------
// Robust physical mailbox transfer
// ---------------------------------------------------------------------------
// A logical HPS command is transmitted TWICE with identical bits[6:0] and a
// different raw sequence bit[7] on each physical write.
//
// Each FPGA clock domain:
//   1) synchronizes the complete 8-bit PIO word,
//   2) requires it to be unchanged for >=8 destination clocks,
//   3) stores the first copy,
//   4) executes ONLY when the second copy has the identical 7-bit body.
//
// This is deliberately stronger than a normal toggle mailbox. A torn CDC word,
// a missed write, or a single corrupted copy cannot execute a game command.
localparam [18:0] CMD_PAIR_TIMEOUT_50 = 19'd250000; // 5 ms @ 50 MHz

reg [7:0] hps_game_cmd_meta;
reg [7:0] hps_game_cmd_sync;
reg [7:0] hps_game_cmd_sync2;
reg [7:0] hps_game_cmd_candidate;
reg [3:0] hps_game_cmd_stable_count;
reg       hps_game_raw_seen_toggle;
reg       hps_game_pair_pending;
reg [6:0] hps_game_first_body;
reg [18:0] hps_game_pair_timeout;

wire hps_game_raw_ready =
    (hps_game_cmd_stable_count >= 4'd8) &&
    (hps_game_cmd_candidate[7] != hps_game_raw_seen_toggle);

// HDMI-domain command acknowledgement/error are synchronized back to 50 MHz
// and exposed to the HPS through bridge_test_in.
reg hdmi_cmd_ack_toggle;
reg hdmi_cmd_error;
reg [3:0] hdmi_cmd_ack_delay;
reg hdmi_cmd_ack_meta_50;
reg hdmi_cmd_ack_sync_50;
reg hdmi_cmd_error_meta_50;
reg hdmi_cmd_error_sync_50;

reg       game_capture_busy;
reg [3:0] game_capture_coord;
reg [2:0] game_countdown_sec;
reg [27:0] game_capture_cycles_left;
reg [25:0] game_second_counter;
reg       game_capture_has_sample;

reg [15:0] game_class_hist [0:53];
reg        game_scan_active;
reg [5:0]  game_scan_index;
reg [15:0] game_best_count;
reg [5:0]  game_best_class;
reg [5:0]  game_result_class;
reg        game_capture_result_valid;

integer game_hist_i;

always @(posedge FPGA_CLK1_50 or negedge RESET_N) begin
    if (!RESET_N) begin
        hps_game_cmd_meta           <= 8'd0;
        hps_game_cmd_sync           <= 8'd0;
        hps_game_cmd_sync2          <= 8'd0;
        hps_game_cmd_candidate      <= 8'd0;
        hps_game_cmd_stable_count   <= 4'd0;
        hps_game_raw_seen_toggle    <= 1'b0;
        hps_game_pair_pending       <= 1'b0;
        hps_game_first_body         <= 7'd0;
        hps_game_pair_timeout       <= 19'd0;

        hdmi_cmd_ack_meta_50        <= 1'b0;
        hdmi_cmd_ack_sync_50        <= 1'b0;
        hdmi_cmd_error_meta_50      <= 1'b0;
        hdmi_cmd_error_sync_50      <= 1'b0;

        game_capture_busy           <= 1'b0;
        game_capture_coord          <= 4'd0;
        game_countdown_sec          <= 3'd0;
        game_capture_cycles_left    <= 28'd0;
        game_second_counter         <= 26'd0;
        game_capture_has_sample     <= 1'b0;
        game_scan_active            <= 1'b0;
        game_scan_index             <= 6'd0;
        game_best_count             <= 16'd0;
        game_best_class             <= 6'd0;
        game_result_class           <= 6'd0;
        game_capture_result_valid   <= 1'b0;

        for (game_hist_i = 0; game_hist_i < 54; game_hist_i = game_hist_i + 1)
            game_class_hist[game_hist_i] <= 16'd0;
    end else begin
        // HDMI-domain link-status return synchronization.
        hdmi_cmd_ack_meta_50   <= hdmi_cmd_ack_toggle;
        hdmi_cmd_ack_sync_50   <= hdmi_cmd_ack_meta_50;
        hdmi_cmd_error_meta_50 <= hdmi_cmd_error;
        hdmi_cmd_error_sync_50 <= hdmi_cmd_error_meta_50;

        // Full-byte CDC synchronizer.
        hps_game_cmd_meta  <= bridge_test_out;
        hps_game_cmd_sync  <= hps_game_cmd_meta;
        hps_game_cmd_sync2 <= hps_game_cmd_sync;

        // Require a stable synchronized byte before accepting a physical copy.
        if (hps_game_cmd_sync2 != hps_game_cmd_candidate) begin
            hps_game_cmd_candidate    <= hps_game_cmd_sync2;
            hps_game_cmd_stable_count <= 4'd0;
        end else if (hps_game_cmd_stable_count < 4'd15) begin
            hps_game_cmd_stable_count <= hps_game_cmd_stable_count + 4'd1;
        end

        // Abandon an incomplete first-copy transaction after 5 ms so a lost
        // second copy can never poison a later command.
        if (hps_game_pair_pending) begin
            if (hps_game_pair_timeout >= (CMD_PAIR_TIMEOUT_50 - 19'd1)) begin
                hps_game_pair_pending <= 1'b0;
                hps_game_pair_timeout <= 19'd0;
            end else begin
                hps_game_pair_timeout <= hps_game_pair_timeout + 19'd1;
            end
        end else begin
            hps_game_pair_timeout <= 19'd0;
        end

        if (hps_game_raw_ready) begin
            hps_game_raw_seen_toggle <= hps_game_cmd_candidate[7];

            if (!hps_game_pair_pending) begin
                // First physical copy.
                hps_game_first_body   <= hps_game_cmd_candidate[6:0];
                hps_game_pair_pending <= 1'b1;
                hps_game_pair_timeout <= 19'd0;

                // HPS has already consumed the previous result before it sends
                // a new command. Clearing on the first copy exposes ACK status
                // while the display transaction is being confirmed.
                game_capture_result_valid <= 1'b0;
            end else begin
                // Second physical copy. Execute only an exact body match.
                hps_game_pair_pending <= 1'b0;
                hps_game_pair_timeout <= 19'd0;

                if (hps_game_cmd_candidate[6:0] == hps_game_first_body) begin
                    if ((hps_game_first_body[6:4] == GAME_CMD_CAPTURE) &&
                        !game_capture_busy && !game_scan_active) begin

                        game_capture_busy         <= 1'b1;
                        game_capture_coord        <= hps_game_first_body[3:0];
                        game_countdown_sec        <= 3'd5;
                        game_capture_cycles_left  <= GAME_CAPTURE_CYCLES - 28'd1;
                        game_second_counter       <= 26'd0;
                        game_capture_has_sample   <= 1'b0;
                        game_capture_result_valid <= 1'b0;
                        game_best_count           <= 16'd0;
                        game_best_class           <= 6'd0;
                        game_scan_index           <= 6'd0;

                        for (game_hist_i = 0; game_hist_i < 54; game_hist_i = game_hist_i + 1)
                            game_class_hist[game_hist_i] <= 16'd0;
                    end
                end
            end
        end

        if (game_capture_busy) begin
            if (CNN_done && (CNN_prediction <= 6'd53)) begin
                game_class_hist[CNN_prediction] <= game_class_hist[CNN_prediction] + 16'd1;
                game_capture_has_sample <= 1'b1;
            end

            if (game_second_counter == (GAME_ONE_SEC_CYCLES - 26'd1)) begin
                game_second_counter <= 26'd0;
                if (game_countdown_sec != 3'd0)
                    game_countdown_sec <= game_countdown_sec - 3'd1;
            end else begin
                game_second_counter <= game_second_counter + 26'd1;
            end

            if (game_capture_cycles_left == 28'd0) begin
                game_capture_busy  <= 1'b0;
                game_countdown_sec <= 3'd0;

                if (game_capture_has_sample ||
                    (CNN_done && (CNN_prediction <= 6'd53))) begin
                    game_scan_active <= 1'b1;
                    game_scan_index  <= 6'd0;
                    game_best_count  <= 16'd0;
                    game_best_class  <= 6'd0;
                end
            end else begin
                game_capture_cycles_left <= game_capture_cycles_left - 28'd1;
            end
        end

        // Sequential maximum search keeps the 54-class majority vote off the
        // critical path.
        if (game_scan_active) begin
            if (game_scan_index < 6'd53) begin
                if (game_class_hist[game_scan_index] > game_best_count) begin
                    game_best_count <= game_class_hist[game_scan_index];
                    game_best_class <= game_scan_index;
                end
                game_scan_index <= game_scan_index + 6'd1;
            end else begin
                if (game_class_hist[53] > game_best_count)
                    game_result_class <= 6'd53;
                else
                    game_result_class <= game_best_class;

                game_capture_result_valid <= 1'b1;
                game_scan_active          <= 1'b0;
            end
        end
    end
end

wire game_status_busy = game_capture_busy | game_scan_active;

// HPS status format:
//   capture busy:
//     bit7=1, bits6:4=countdown, bit3=display ACK, bit2=link error
//   idle + capture result valid:
//     bit7=0, bit6=1, bits5:0=majority class
//   idle + no pending result:
//     bit7=0, bit6=0, bit5=display ACK, bit4=link error, bits3:0=0
//
// The old coordinate echo is intentionally removed; HPS already owns the
// active coordinate, while ACK/error feedback is much more valuable.
assign bridge_test_in = game_status_busy
                      ? {1'b1, game_countdown_sec,
                         hdmi_cmd_ack_sync_50, hdmi_cmd_error_sync_50, 2'b00}
                      : (game_capture_result_valid
                         ? {1'b0, 1'b1, game_result_class}
                         : {1'b0, 1'b0,
                            hdmi_cmd_ack_sync_50, hdmi_cmd_error_sync_50, 4'b0000});

// ---------------------------------------------------------------------------
// CNN result -> HDMI clock domain
// ---------------------------------------------------------------------------
// The class bus is stable from one completed inference to the next.  The
// result-toggle acts as an event marker.  We synchronize both, detect the
// toggle in the HDMI domain, then atomically latch the already-settled class
// bus.  This avoids using the 50-MHz CNN result directly in 148.5-MHz logic.
reg [5:0] CNN_prediction_hdmi_meta;
reg [5:0] CNN_prediction_hdmi_sync;
reg [5:0] CNN_prediction_hdmi;
reg       CNN_bbox_valid_hdmi_meta;
reg       CNN_bbox_valid_hdmi_sync;
reg       CNN_bbox_valid_hdmi;
reg [10:0] CNN_bbox_min_x_hdmi_meta, CNN_bbox_min_x_hdmi_sync, CNN_bbox_min_x_hdmi;
reg [10:0] CNN_bbox_max_x_hdmi_meta, CNN_bbox_max_x_hdmi_sync, CNN_bbox_max_x_hdmi;
reg [10:0] CNN_bbox_min_y_hdmi_meta, CNN_bbox_min_y_hdmi_sync, CNN_bbox_min_y_hdmi;
reg [10:0] CNN_bbox_max_y_hdmi_meta, CNN_bbox_max_y_hdmi_sync, CNN_bbox_max_y_hdmi;
reg       CNN_toggle_hdmi_meta;
reg       CNN_toggle_hdmi_sync;
reg       CNN_toggle_hdmi_d;
reg       CNN_valid_hdmi;

always @(posedge HDMI_CLK or negedge RESET_N) begin
    if (!RESET_N) begin
        CNN_prediction_hdmi_meta <= 6'd0;
        CNN_prediction_hdmi_sync <= 6'd0;
        CNN_prediction_hdmi      <= 6'd0;
        CNN_bbox_valid_hdmi_meta <= 1'b0;
        CNN_bbox_valid_hdmi_sync <= 1'b0;
        CNN_bbox_valid_hdmi      <= 1'b0;
        CNN_bbox_min_x_hdmi_meta <= 11'd0;
        CNN_bbox_min_x_hdmi_sync <= 11'd0;
        CNN_bbox_min_x_hdmi      <= 11'd0;
        CNN_bbox_max_x_hdmi_meta <= 11'd0;
        CNN_bbox_max_x_hdmi_sync <= 11'd0;
        CNN_bbox_max_x_hdmi      <= 11'd0;
        CNN_bbox_min_y_hdmi_meta <= 11'd0;
        CNN_bbox_min_y_hdmi_sync <= 11'd0;
        CNN_bbox_min_y_hdmi      <= 11'd0;
        CNN_bbox_max_y_hdmi_meta <= 11'd0;
        CNN_bbox_max_y_hdmi_sync <= 11'd0;
        CNN_bbox_max_y_hdmi      <= 11'd0;
        CNN_toggle_hdmi_meta     <= 1'b0;
        CNN_toggle_hdmi_sync     <= 1'b0;
        CNN_toggle_hdmi_d        <= 1'b0;
        CNN_valid_hdmi           <= 1'b0;
    end else begin
        CNN_prediction_hdmi_meta <= CNN_prediction_latched;
        CNN_prediction_hdmi_sync <= CNN_prediction_hdmi_meta;
        CNN_bbox_valid_hdmi_meta <= CNN_bbox_valid_latched;
        CNN_bbox_valid_hdmi_sync <= CNN_bbox_valid_hdmi_meta;
        CNN_bbox_min_x_hdmi_meta <= CNN_bbox_min_x_latched;
        CNN_bbox_min_x_hdmi_sync <= CNN_bbox_min_x_hdmi_meta;
        CNN_bbox_max_x_hdmi_meta <= CNN_bbox_max_x_latched;
        CNN_bbox_max_x_hdmi_sync <= CNN_bbox_max_x_hdmi_meta;
        CNN_bbox_min_y_hdmi_meta <= CNN_bbox_min_y_latched;
        CNN_bbox_min_y_hdmi_sync <= CNN_bbox_min_y_hdmi_meta;
        CNN_bbox_max_y_hdmi_meta <= CNN_bbox_max_y_latched;
        CNN_bbox_max_y_hdmi_sync <= CNN_bbox_max_y_hdmi_meta;

        CNN_toggle_hdmi_meta <= CNN_result_toggle;
        CNN_toggle_hdmi_sync <= CNN_toggle_hdmi_meta;
        CNN_toggle_hdmi_d    <= CNN_toggle_hdmi_sync;

        // By the time the synchronized toggle change is observed here, the
        // synchronized class bus has been stable for multiple HDMI clocks.
        if (CNN_toggle_hdmi_sync != CNN_toggle_hdmi_d) begin
            CNN_prediction_hdmi <= CNN_prediction_hdmi_sync;
            CNN_bbox_valid_hdmi <= CNN_bbox_valid_hdmi_sync;
            CNN_bbox_min_x_hdmi <= CNN_bbox_min_x_hdmi_sync;
            CNN_bbox_max_x_hdmi <= CNN_bbox_max_x_hdmi_sync;
            CNN_bbox_min_y_hdmi <= CNN_bbox_min_y_hdmi_sync;
            CNN_bbox_max_y_hdmi <= CNN_bbox_max_y_hdmi_sync;
            CNN_valid_hdmi      <= 1'b1;
        end
    end
end


// ===========================================================================
// HPS-owned game/display state (HDMI clock domain)
// ---------------------------------------------------------------------------
// HPS remains the authoritative owner of every card identity/state, score and
// turn.  FPGA only stores a display copy.
//
// Robust mailbox protocol:
//   - every logical command is sent twice,
//   - both synchronized 7-bit bodies must match,
//   - a complete logical command toggles hdmi_cmd_ack_toggle,
//   - protocol/semantic failure sets hdmi_cmd_error,
//   - HPS waits for the ACK transition before sending the next command.
//
// Cell updates are additionally staged:
//   SELECT_CELL -> CLASS_LOW -> CELL_COMMIT.
// CELL_COMMIT is ignored unless both previous stages are valid. This prevents a
// missed SELECT/CLASS command from reusing stale data and writing the wrong cell.
// ===========================================================================
localparam [19:0] CMD_PAIR_TIMEOUT_HDMI = 20'd742500; // 5 ms @ 148.5 MHz

reg [7:0] hps_hdmi_cmd_meta;
reg [7:0] hps_hdmi_cmd_sync;
reg [7:0] hps_hdmi_cmd_sync2;
reg [7:0] hps_hdmi_cmd_candidate;
reg [3:0] hps_hdmi_cmd_stable_count;
reg       hps_hdmi_raw_seen_toggle;
reg       hps_hdmi_pair_pending;
reg [6:0] hps_hdmi_first_body;
reg [19:0] hps_hdmi_pair_timeout;

wire hps_hdmi_raw_ready =
    (hps_hdmi_cmd_stable_count >= 4'd8) &&
    (hps_hdmi_cmd_candidate[7] != hps_hdmi_raw_seen_toggle);

reg [3:0] hps_selected_cell;
reg [3:0] hps_class_low;
reg       hps_selected_valid;
reg       hps_class_low_valid;

// RESET_GAME is protected by a two-command application-level key sequence.
// An accidental opcode-7 decode cannot clear the board.
reg hps_reset_armed;
localparam [3:0] GAME_RESET_ARM_MAGIC  = 4'hA;
localparam [3:0] GAME_RESET_EXEC_MAGIC = 4'h5;

reg [5:0] game_board_class [0:15];
reg [1:0] game_board_state [0:15];
reg [3:0] game_score;
reg [7:0] game_turn;
reg [1:0] game_result_state;
integer game_board_i;

// Capture status is generated in the 50-MHz domain; synchronize the stable
// display fields for countdown/highlight rendering.
reg       game_busy_meta, game_busy_sync;
reg [2:0] game_countdown_meta, game_countdown_sync;
reg [3:0] game_active_coord_meta, game_active_coord_sync;

always @(posedge HDMI_CLK or negedge RESET_N) begin
    if (!RESET_N) begin
        hps_hdmi_cmd_meta          <= 8'd0;
        hps_hdmi_cmd_sync          <= 8'd0;
        hps_hdmi_cmd_sync2         <= 8'd0;
        hps_hdmi_cmd_candidate     <= 8'd0;
        hps_hdmi_cmd_stable_count  <= 4'd0;
        hps_hdmi_raw_seen_toggle   <= 1'b0;
        hps_hdmi_pair_pending      <= 1'b0;
        hps_hdmi_first_body        <= 7'd0;
        hps_hdmi_pair_timeout      <= 20'd0;

        hdmi_cmd_ack_toggle        <= 1'b0;
        hdmi_cmd_error             <= 1'b0;
        hdmi_cmd_ack_delay         <= 4'd0;

        hps_selected_cell          <= 4'd0;
        hps_class_low              <= 4'd0;
        hps_selected_valid         <= 1'b0;
        hps_class_low_valid        <= 1'b0;
        hps_reset_armed            <= 1'b0;
        game_score               <= 4'd0;
        game_turn                 <= 8'd1;
        game_result_state          <= 2'd0;

        game_busy_meta             <= 1'b0;
        game_busy_sync             <= 1'b0;
        game_countdown_meta        <= 3'd0;
        game_countdown_sync        <= 3'd0;
        game_active_coord_meta     <= 4'd0;
        game_active_coord_sync     <= 4'd0;

        for (game_board_i = 0; game_board_i < 16; game_board_i = game_board_i + 1) begin
            game_board_class[game_board_i] <= 6'd0;
            game_board_state[game_board_i] <= 2'd0;
        end
    end else begin
        // Return ACK only AFTER the transaction error/status bit has had eight
        // HDMI clocks to settle.  The error bit therefore reaches the 50-MHz
        // status synchronizer before the ACK transition can be observed.
        if (hdmi_cmd_ack_delay != 4'd0) begin
            if (hdmi_cmd_ack_delay == 4'd1) begin
                hdmi_cmd_ack_toggle <= ~hdmi_cmd_ack_toggle;
                hdmi_cmd_ack_delay  <= 4'd0;
            end else begin
                hdmi_cmd_ack_delay <= hdmi_cmd_ack_delay - 4'd1;
            end
        end

        // Synchronize capture display fields.
        game_busy_meta         <= game_status_busy;
        game_busy_sync         <= game_busy_meta;
        game_countdown_meta    <= game_countdown_sec;
        game_countdown_sync    <= game_countdown_meta;
        game_active_coord_meta <= game_capture_coord;
        game_active_coord_sync <= game_active_coord_meta;

        // Synchronize the full mailbox byte.
        hps_hdmi_cmd_meta  <= bridge_test_out;
        hps_hdmi_cmd_sync  <= hps_hdmi_cmd_meta;
        hps_hdmi_cmd_sync2 <= hps_hdmi_cmd_sync;

        // Require >=8 identical HDMI-clock samples.
        if (hps_hdmi_cmd_sync2 != hps_hdmi_cmd_candidate) begin
            hps_hdmi_cmd_candidate    <= hps_hdmi_cmd_sync2;
            hps_hdmi_cmd_stable_count <= 4'd0;
        end else if (hps_hdmi_cmd_stable_count < 4'd15) begin
            hps_hdmi_cmd_stable_count <= hps_hdmi_cmd_stable_count + 4'd1;
        end

        // A lost second copy cannot leave stale transaction state forever.
        if (hps_hdmi_pair_pending) begin
            if (hps_hdmi_pair_timeout >= (CMD_PAIR_TIMEOUT_HDMI - 20'd1)) begin
                hps_hdmi_pair_pending <= 1'b0;
                hps_hdmi_pair_timeout <= 20'd0;
            end else begin
                hps_hdmi_pair_timeout <= hps_hdmi_pair_timeout + 20'd1;
            end
        end else begin
            hps_hdmi_pair_timeout <= 20'd0;
        end

        if (hps_hdmi_raw_ready) begin
            hps_hdmi_raw_seen_toggle <= hps_hdmi_cmd_candidate[7];

            if (!hps_hdmi_pair_pending) begin
                // First copy: stage body only; NEVER execute yet.
                hps_hdmi_first_body   <= hps_hdmi_cmd_candidate[6:0];
                hps_hdmi_pair_pending <= 1'b1;
                hps_hdmi_pair_timeout <= 20'd0;
            end else begin
                // Second copy completes one logical transaction.  Error/status
                // is committed now; ACK is deliberately delayed by eight HDMI
                // clocks so the return CDC cannot expose a new ACK with stale
                // error information.
                hps_hdmi_pair_pending <= 1'b0;
                hps_hdmi_pair_timeout <= 20'd0;
                hdmi_cmd_ack_delay    <= 4'd8;

                if (hps_hdmi_cmd_candidate[6:0] != hps_hdmi_first_body) begin
                    // Physical copies disagree: execute nothing.
                    hdmi_cmd_error      <= 1'b1;
                    hps_selected_valid  <= 1'b0;
                    hps_class_low_valid <= 1'b0;
                    hps_reset_armed     <= 1'b0;
                end else begin
                    // Matching pair. Default to success; individual semantic
                    // checks below may set the error flag again.
                    hdmi_cmd_error <= 1'b0;

                    // Any non-reset command cancels a half-completed reset key.
                    if (hps_hdmi_first_body[6:4] != GAME_CMD_RESET)
                        hps_reset_armed <= 1'b0;

                    case (hps_hdmi_first_body[6:4])
                        GAME_CMD_CAPTURE: begin
                            // Capture itself is handled in the 50-MHz domain.
                            // Clear any abandoned cell staging to prevent stale
                            // data from crossing capture boundaries.
                            hps_selected_valid  <= 1'b0;
                            hps_class_low_valid <= 1'b0;
                        end

                        GAME_CMD_SELECT_CELL: begin
                            hps_selected_cell  <= hps_hdmi_first_body[3:0];
                            hps_selected_valid <= 1'b1;
                            hps_class_low_valid<= 1'b0;
                        end

                        GAME_CMD_CLASS_LOW: begin
                            if (hps_selected_valid) begin
                                hps_class_low       <= hps_hdmi_first_body[3:0];
                                hps_class_low_valid <= 1'b1;
                            end else begin
                                // Never permit CLASS_LOW to reuse an old cell.
                                hdmi_cmd_error      <= 1'b1;
                                hps_class_low_valid <= 1'b0;
                            end
                        end

                        GAME_CMD_CELL_COMMIT: begin
                            if (hps_selected_valid &&
                                hps_class_low_valid &&
                                ({hps_hdmi_first_body[1:0], hps_class_low} <= 6'd53)) begin

                                game_board_class[hps_selected_cell] <= {
                                    hps_hdmi_first_body[1:0], hps_class_low
                                };
                                game_board_state[hps_selected_cell] <=
                                    hps_hdmi_first_body[3:2];

                                // A commit consumes the staged transaction.
                                hps_selected_valid  <= 1'b0;
                                hps_class_low_valid <= 1'b0;
                            end else begin
                                // Do not write ANY cell with stale/invalid stage.
                                hdmi_cmd_error      <= 1'b1;
                                hps_selected_valid  <= 1'b0;
                                hps_class_low_valid <= 1'b0;
                            end
                        end

                        GAME_CMD_SCORE: begin
                            hps_selected_valid  <= 1'b0;
                            hps_class_low_valid <= 1'b0;
                            if (hps_hdmi_first_body[3:0] <= 4'd8)
                                game_score <= hps_hdmi_first_body[3:0];
                            else
                                hdmi_cmd_error <= 1'b1;
                        end

                        GAME_CMD_TURN: begin
                            // SELECT_CELL stages turn[3:0]; TURN commits turn[7:4].
                            // Retry the complete two-command transaction on HPS.
                            // A preceding CLASS_LOW is not valid for this command.
                            if (hps_selected_valid && !hps_class_low_valid)
                                game_turn <= {hps_hdmi_first_body[3:0], hps_selected_cell};
                            else
                                hdmi_cmd_error <= 1'b1;
                            hps_selected_valid  <= 1'b0;
                            hps_class_low_valid <= 1'b0;
                        end

                        GAME_CMD_CONTROL: begin
                            hps_selected_valid  <= 1'b0;
                            hps_class_low_valid <= 1'b0;

                            // Single player: payload[3] and [0] reserved 0; result 3 invalid.
                            if ((hps_hdmi_first_body[3] == 1'b0) &&
                                (hps_hdmi_first_body[0] == 1'b0) &&
                                (hps_hdmi_first_body[2:1] != 2'b11)) begin
                                game_result_state <= hps_hdmi_first_body[2:1];
                            end else begin
                                hdmi_cmd_error <= 1'b1;
                            end
                        end

                        GAME_CMD_RESET: begin
                            hps_selected_valid  <= 1'b0;
                            hps_class_low_valid <= 1'b0;

                            if (hps_hdmi_first_body[3:0] == GAME_RESET_ARM_MAGIC) begin
                                // ARM does not modify game state.
                                hps_reset_armed <= 1'b1;
                            end else if ((hps_hdmi_first_body[3:0] == GAME_RESET_EXEC_MAGIC) &&
                                         hps_reset_armed) begin
                                // Only the A -> 5 key sequence may erase state.
                                hps_reset_armed    <= 1'b0;
                                game_score       <= 4'd0;
                                game_turn                 <= 8'd1;
                                game_result_state  <= 2'd0;
                                hps_selected_cell  <= 4'd0;
                                hps_class_low      <= 4'd0;

                                for (game_board_i = 0; game_board_i < 16; game_board_i = game_board_i + 1) begin
                                    game_board_class[game_board_i] <= 6'd0;
                                    game_board_state[game_board_i] <= 2'd0;
                                end
                            end else begin
                                // Invalid reset payload or EXEC without ARM.
                                hdmi_cmd_error <= 1'b1;
                                hps_reset_armed <= 1'b0;
                            end
                        end

                        default: begin
                            hdmi_cmd_error      <= 1'b1;
                            hps_selected_valid  <= 1'b0;
                            hps_class_low_valid <= 1'b0;
                            hps_reset_armed     <= 1'b0;
                        end
                    endcase
                end
            end
        end
    end
end

wire [95:0] game_cards_flat = {
    game_board_class[15], game_board_class[14], game_board_class[13], game_board_class[12],
    game_board_class[11], game_board_class[10], game_board_class[9],  game_board_class[8],
    game_board_class[7],  game_board_class[6],  game_board_class[5],  game_board_class[4],
    game_board_class[3],  game_board_class[2],  game_board_class[1],  game_board_class[0]
};

wire [31:0] game_states_flat = {
    game_board_state[15], game_board_state[14], game_board_state[13], game_board_state[12],
    game_board_state[11], game_board_state[10], game_board_state[9],  game_board_state[8],
    game_board_state[7],  game_board_state[6],  game_board_state[5],  game_board_state[4],
    game_board_state[3],  game_board_state[2],  game_board_state[1],  game_board_state[0]
};

reg [4:0] game_remaining_cards;
integer game_rem_i;
always @* begin
    game_remaining_cards = 5'd16;
    for (game_rem_i = 0; game_rem_i < 16; game_rem_i = game_rem_i + 1)
        if (game_board_state[game_rem_i] == 2'd3)
            game_remaining_cards = game_remaining_cards - 5'd1;
end

// The old full-resolution CNN overlay is intentionally not instantiated here.
// The miniature preview draws the scaled bounding box directly. This removes
// an unused 148.5-MHz render path and reduces routing pressure.

// V9: the complex UI is rendered at 50 MHz into two small scanline banks.
// HDMI reads RAM and combines it with the registered camera thumbnail only.
wire [7:0] v9_r, v9_g, v9_b;
wire v9_hs, v9_vs, v9_de;
wire v9_ui_underrun;
memory_display_v9 DISPLAY (
    .pixel_clk(HDMI_CLK), .render_clk(FPGA_CLK1_50), .reset_n(RESET_N),
    .in_r(video_r_pipe), .in_g(video_g_pipe), .in_b(video_b_pipe),
    .in_hs(video_hs_pipe), .in_vs(video_vs_pipe), .in_de(video_de_pipe),
    .board_cards(game_cards_flat), .board_states(game_states_flat),
    .score(game_score), .turn_number(game_turn), .remaining_cards(game_remaining_cards),
    .result_state(game_result_state), .capture_busy(game_busy_sync),
    .countdown_sec(game_countdown_sync), .capture_coord(game_active_coord_sync),
    .class_id(CNN_prediction_hdmi), .class_valid(CNN_valid_hdmi),
    .bbox_valid(CNN_bbox_valid_hdmi), .bbox_min_x(CNN_bbox_min_x_hdmi),
    .bbox_max_x(CNN_bbox_max_x_hdmi), .bbox_min_y(CNN_bbox_min_y_hdmi),
    .bbox_max_y(CNN_bbox_max_y_hdmi),
    .out_r(v9_r), .out_g(v9_g), .out_b(v9_b),
    .out_hs(v9_hs), .out_vs(v9_vs), .out_de(v9_de),
    .ui_underrun(v9_ui_underrun)
);
assign HDMI_TX_D={v9_r,v9_g,v9_b};
assign HDMI_TX_HS=v9_hs;
assign HDMI_TX_VS=v9_vs;
assign HDMI_TX_DE=v9_de;
// Retain the existing LED status mapping. The display shows a small red
// upper-right marker if its scanline prefetch ever misses a deadline.
assign LED[7:0]=bridge_test_in;
assign CNN_status={1'b0,CNN_result_toggle,CNN_prediction_latched};
endmodule

// V9 display: 50-MHz UI shader -> two 480-pixel scanlines -> 148.5-MHz HDMI.
// Complex typography/card geometry is absent from the HDMI combinational path.
module memory_display_v9(
 input wire pixel_clk,render_clk,reset_n,
 input wire [7:0] in_r,in_g,in_b,
 input wire in_hs,in_vs,in_de,
 input wire [95:0] board_cards,
 input wire [31:0] board_states,
 input wire [3:0] score,
 input wire [7:0] turn_number,
 input wire [4:0] remaining_cards,
 input wire [1:0] result_state,
 input wire capture_busy,
 input wire [2:0] countdown_sec,
 input wire [3:0] capture_coord,
 input wire [5:0] class_id,
 input wire class_valid,bbox_valid,
 input wire [10:0] bbox_min_x,bbox_max_x,bbox_min_y,bbox_max_y,
 output reg [7:0] out_r,out_g,out_b,
 output reg out_hs,out_vs,out_de,
 output reg ui_underrun
);
 reg de_d,vs_d,line_seen;
 reg [10:0] px,py;
 wire fs=in_vs && !vs_d;
 wire ls=in_de && !de_d;
 wire [10:0] x=ls?11'd0:px+11'd1;
 wire [10:0] y=ls?(line_seen?py+11'd1:11'd0):py;
 always @(posedge pixel_clk or negedge reset_n)begin
  if(!reset_n)begin de_d<=0;vs_d<=0;line_seen<=0;px<=0;py<=0;end
  else begin
   de_d<=in_de;vs_d<=in_vs;
   if(fs)begin px<=0;py<=0;line_seen<=0;end
   else if(in_de)begin px<=x;py<=y;line_seen<=1;end
  end
 end

 // Frame snapshot: this bundle stays unchanged for the whole video frame.
 // It settles before the request-toggle synchronizer reaches the renderer.
 (* preserve *) reg [95:0] cards_frame;
 (* preserve *) reg [31:0] states_frame;
 (* preserve *) reg [3:0] score_frame,coord_frame;
 (* preserve *) reg [7:0] turn_frame;
 (* preserve *) reg [4:0] remaining_frame;
 (* preserve *) reg [1:0] result_frame;
 (* preserve *) reg busy_frame;
 (* preserve *) reg [2:0] countdown_frame;
 (* preserve *) reg [5:0] class_frame;
 (* preserve *) reg class_valid_frame;
 reg bbox_frame;
 reg [10:0] bx0,bx1,by0,by1;
 function [10:0] scale_bbox;
  input [10:0] p;
  reg [12:0] v;
  begin v={2'b0,p}*13'd3;scale_bbox={1'b0,v[12:3]};end
 endfunction
 always @(posedge pixel_clk or negedge reset_n)begin
  if(!reset_n)begin
   cards_frame<=0;states_frame<=0;score_frame<=0;turn_frame<=1;
   remaining_frame<=16;result_frame<=0;busy_frame<=0;countdown_frame<=0;
   coord_frame<=0;class_frame<=0;class_valid_frame<=0;bbox_frame<=0;
   bx0<=1152;bx1<=1152;by0<=624;by1<=624;
  end else if(fs)begin
   cards_frame<=board_cards;states_frame<=board_states;score_frame<=score;
   turn_frame<=turn_number;remaining_frame<=remaining_cards;result_frame<=result_state;
   busy_frame<=capture_busy;countdown_frame<=countdown_sec;coord_frame<=capture_coord;
   class_frame<=class_id;class_valid_frame<=class_valid;
   bbox_frame<=bbox_valid && class_valid && bbox_min_x<=bbox_max_x &&
               bbox_min_y<=bbox_max_y && bbox_max_x<1920 && bbox_max_y<1080;
   bx0<=1152+scale_bbox(bbox_min_x);bx1<=1152+scale_bbox(bbox_max_x);
   by0<=624+scale_bbox(bbox_min_y);by1<=624+scale_bbox(bbox_max_y);
  end
 end

 // Request and acknowledgement toggles cross domains through two registers.
 // Payload is held from request until completion. Bank is row[0].
 (* preserve *) reg request_toggle;
 (* preserve *) reg [8:0] requested_row;
 (* altera_attribute = "-name SYNCHRONIZER_IDENTIFICATION FORCED_IF_ASYNCHRONOUS" *) reg req_meta,req_sync;
 (* preserve *) reg ack_toggle;
 (* preserve *) reg [8:0] completed_row;
 (* altera_attribute = "-name SYNCHRONIZER_IDENTIFICATION FORCED_IF_ASYNCHRONOUS" *) reg ack_meta,ack_sync;
 reg ack_seen;
 reg [1:0] line_ready;
 reg [8:0] ready_row0,ready_row1;
 wire [8:0] ui_row=y[10:2];
 wire ui_available=ui_row[0]?(line_ready[1] && ready_row1==ui_row):
                                      (line_ready[0] && ready_row0==ui_row);
 always @(posedge pixel_clk or negedge reset_n)begin
  if(!reset_n)begin
   ack_meta<=0;ack_sync<=0;ack_seen<=0;request_toggle<=0;requested_row<=0;
   line_ready<=0;ready_row0<=0;ready_row1<=0;ui_underrun<=0;
  end else begin
   ack_meta<=ack_toggle;ack_sync<=ack_meta;
   if(ack_sync!=ack_seen)begin
    ack_seen<=ack_sync;
    line_ready[completed_row[0]]<=1;
    if(completed_row[0])ready_row1<=completed_row;else ready_row0<=completed_row;
   end
   if(fs)begin
    line_ready<=0;requested_row<=0;request_toggle<=~request_toggle;
   end else if(ls && y<1080 && y[1:0]==0)begin
    if(!ui_available)ui_underrun<=1;
    if(ui_row<269)begin
     if(ack_sync==request_toggle)begin
      requested_row<=ui_row+9'd1;request_toggle<=~request_toggle;
      line_ready[~ui_row[0]]<=0;
     end else ui_underrun<=1;
    end
   end
  end
 end

 (* ramstyle="M10K, no_rw_check" *) reg [15:0] ui_lines[0:1023];
 reg rendering;
 reg [1:0] render_phase;
 reg [8:0] render_x,render_y;
 reg write_valid;
 reg [8:0] write_x,write_y;
 reg [95:0] cards_slow;
 reg [31:0] states_slow;
 reg [3:0] score_slow,coord_slow;
 reg [7:0] turn_slow;
 reg [4:0] remaining_slow;
 reg [1:0] result_slow;
 reg busy_slow;
 reg [2:0] countdown_slow;
 reg [5:0] class_slow;
 reg class_valid_slow;
 wire [15:0] shader_rgb;
 memory_ui_shader_v9 SHADER(
  .clk(render_clk),.enable(rendering && render_phase==3),.x(render_x),.y(render_y),.cards(cards_slow),.states(states_slow),
  .score(score_slow),.turn_number(turn_slow),.remaining_cards(remaining_slow),
  .result_state(result_slow),.capture_busy(busy_slow),.countdown_sec(countdown_slow),
  .capture_coord(coord_slow),.detected_class(class_slow),.detected_valid(class_valid_slow),.rgb(shader_rgb)
 );
 always @(posedge render_clk or negedge reset_n)begin
  if(!reset_n)begin
   req_meta<=0;req_sync<=0;ack_toggle<=0;completed_row<=0;
   rendering<=0;render_phase<=0;render_x<=0;render_y<=0;write_valid<=0;write_x<=0;write_y<=0;
   cards_slow<=0;states_slow<=0;score_slow<=0;turn_slow<=1;remaining_slow<=16;
   result_slow<=0;busy_slow<=0;countdown_slow<=0;coord_slow<=0;class_slow<=0;class_valid_slow<=0;
  end else begin
   req_meta<=request_toggle;req_sync<=req_meta;
   write_valid<=rendering && render_phase==3;
   write_x<=render_x;write_y<=render_y;
   if(!rendering && !write_valid && req_sync!=ack_toggle)begin
    render_x<=0;render_y<=requested_row;rendering<=1;render_phase<=0;
    if(requested_row==0)begin
     cards_slow<=cards_frame;states_slow<=states_frame;score_slow<=score_frame;
     turn_slow<=turn_frame;remaining_slow<=remaining_frame;result_slow<=result_frame;
     busy_slow<=busy_frame;countdown_slow<=countdown_frame;coord_slow<=coord_frame;
     class_slow<=class_frame;class_valid_slow<=class_valid_frame;
    end
   end
   if(rendering)begin
    render_phase<=render_phase+2'd1;
    if(render_phase==3)begin
     if(render_x==479)rendering<=0;else render_x<=render_x+9'd1;
    end
   end
   if(write_valid && write_x==479)begin completed_row<=write_y;ack_toggle<=req_sync;end
  end
 end
 // Keep memory writes in a clock-only process so Quartus infers block RAM.
 always @(posedge render_clk)if(write_valid)ui_lines[{write_y[0],write_x}]<=shader_rgb;

 // Camera thumbnail: same 2 x 240x135 RGB565 frame banks as V8.
 // All RAM addressing uses counters; there is no /3 divider in the pixel path.
 (* ramstyle="M10K, no_rw_check" *) reg [15:0] camera_mem[0:65535];
 reg wr_bank,rd_bank,camera_valid;
 reg [14:0] wr_count;
 wire wr_sample=in_de && x<1920 && y<1080 && x[2:0]==0 && y[2:0]==0 && wr_count<32400;
 always @(posedge pixel_clk)if(wr_sample && !fs)camera_mem[{wr_bank,wr_count}]<={in_r[7:3],in_g[7:2],in_b[7:3]};
 always @(posedge pixel_clk or negedge reset_n)begin
  if(!reset_n)begin wr_bank<=0;rd_bank<=1;wr_count<=0;camera_valid<=0;end
  else if(fs)begin
   if(wr_count==32400)begin rd_bank<=wr_bank;wr_bank<=~wr_bank;camera_valid<=1;end
   wr_count<=0;
  end else if(wr_sample)wr_count<=wr_count+15'd1;
 end
 reg [7:0] cam_col;
 reg [1:0] repeat_x,repeat_y;
 reg [14:0] row_base;
 wire in_camera=in_de && x>=1152 && x<1872 && y>=624 && y<1029;
 always @(posedge pixel_clk or negedge reset_n)begin
  if(!reset_n)begin cam_col<=0;repeat_x<=0;repeat_y<=0;row_base<=0;end
  else if(fs)begin cam_col<=0;repeat_x<=0;repeat_y<=0;row_base<=0;end
  else begin
   if(ls)begin
    cam_col<=0;repeat_x<=0;
    if(y==624)begin row_base<=0;repeat_y<=0;end
    else if(y>624 && y<1029)begin
     if(repeat_y==2)begin row_base<=row_base+15'd240;repeat_y<=0;end
     else repeat_y<=repeat_y+2'd1;
    end
   end
   if(in_camera)begin
    if(repeat_x==2)begin repeat_x<=0;cam_col<=cam_col+8'd1;end
    else repeat_x<=repeat_x+2'd1;
   end
  end
 end
 reg [15:0] camera_q,ui_q;
 wire [14:0] cam_addr=row_base+{7'b0,cam_col};
 always @(posedge pixel_clk)begin
  if(in_camera && camera_valid)camera_q<=camera_mem[{rd_bank,cam_addr}];
  if(in_de && x<1920 && y<1080)ui_q<=ui_lines[{ui_row[0],x[10:2]}];
 end
 reg hs_q,vs_q,de_q,cam_q,box_q,ui_ok_q,fault_q;
 wire bbox_edge=bbox_frame && x>=bx0 && x<=bx1 && y>=by0 && y<=by1 &&
                (x<bx0+2 || x+2>bx1 || y<by0+2 || y+2>by1);
 always @(posedge pixel_clk or negedge reset_n)begin
  if(!reset_n)begin
   hs_q<=0;vs_q<=0;de_q<=0;cam_q<=0;box_q<=0;ui_ok_q<=0;fault_q<=0;
   out_r<=0;out_g<=0;out_b<=0;out_hs<=0;out_vs<=0;out_de<=0;
  end else begin
   hs_q<=in_hs;vs_q<=in_vs;de_q<=in_de;
   cam_q<=in_camera && camera_valid;box_q<=in_camera && bbox_edge;
   ui_ok_q<=ui_available;fault_q<=ui_underrun && x>=1896 && y<12;
   out_hs<=hs_q;out_vs<=vs_q;out_de<=de_q;
   if(!de_q)begin out_r<=0;out_g<=0;out_b<=0;end
   else if(fault_q)begin out_r<=255;out_g<=0;out_b<=0;end
   else if(box_q)begin out_r<=103;out_g<=219;out_b<=239;end
   else if(cam_q)begin
    out_r<={camera_q[15:11],camera_q[15:13]};out_g<={camera_q[10:5],camera_q[10:9]};out_b<={camera_q[4:0],camera_q[4:2]};
   end else if(ui_ok_q)begin
    out_r<={ui_q[15:11],ui_q[15:13]};out_g<={ui_q[10:5],ui_q[10:9]};out_b<={ui_q[4:0],ui_q[4:2]};
   end else begin out_r<=20;out_g<=32;out_b<=56;end
  end
 end
endmodule
// 480x270 UI, rendered at 50 MHz. HDMI repeats each UI texel 4x4.
module memory_ui_shader_v9(
 input wire clk,enable,
 input wire [8:0] x,y,
 input wire [95:0] cards,
 input wire [31:0] states,
 input wire [3:0] score,
 input wire [7:0] turn_number,
 input wire [4:0] remaining_cards,
 input wire [1:0] result_state,
 input wire capture_busy,
 input wire [2:0] countdown_sec,
 input wire [3:0] capture_coord,
 input wire [5:0] detected_class,
 input wire detected_valid,
 output reg [15:0] rgb
);
 localparam [2:0] SUIT_CLUB=0,SUIT_DIAMOND=1,SUIT_HEART=2,SUIT_SPADE=3,SUIT_NONE=4;
 localparam [23:0] BG=24'h142038, PANEL=24'h23324D, LIGHT=24'hEEF1F5,
                  INK=24'h142038, ORANGE=24'hFFB45B, CYAN=24'h67DBEF,
                  MUTED=24'hA8B6CB, GREEN=24'h48BFA0;
    function [4:0] font5x7_row;
        input [7:0] ch;
        input [2:0] row;
        begin
            case (ch)
                "0": case(row) 0:font5x7_row=5'b01110;1:font5x7_row=5'b10001;2:font5x7_row=5'b10011;3:font5x7_row=5'b10101;4:font5x7_row=5'b11001;5:font5x7_row=5'b10001;default:font5x7_row=5'b01110;endcase
                "1": case(row) 0:font5x7_row=5'b00100;1:font5x7_row=5'b01100;2:font5x7_row=5'b00100;3:font5x7_row=5'b00100;4:font5x7_row=5'b00100;5:font5x7_row=5'b00100;default:font5x7_row=5'b01110;endcase
                "2": case(row) 0:font5x7_row=5'b01110;1:font5x7_row=5'b10001;2:font5x7_row=5'b00001;3:font5x7_row=5'b00010;4:font5x7_row=5'b00100;5:font5x7_row=5'b01000;default:font5x7_row=5'b11111;endcase
                "3": case(row) 0:font5x7_row=5'b11110;1:font5x7_row=5'b00001;2:font5x7_row=5'b00001;3:font5x7_row=5'b01110;4:font5x7_row=5'b00001;5:font5x7_row=5'b00001;default:font5x7_row=5'b11110;endcase
                "4": case(row) 0:font5x7_row=5'b00010;1:font5x7_row=5'b00110;2:font5x7_row=5'b01010;3:font5x7_row=5'b10010;4:font5x7_row=5'b11111;5:font5x7_row=5'b00010;default:font5x7_row=5'b00010;endcase
                "5": case(row) 0:font5x7_row=5'b11111;1:font5x7_row=5'b10000;2:font5x7_row=5'b10000;3:font5x7_row=5'b11110;4:font5x7_row=5'b00001;5:font5x7_row=5'b00001;default:font5x7_row=5'b11110;endcase
                "6": case(row) 0:font5x7_row=5'b01110;1:font5x7_row=5'b10000;2:font5x7_row=5'b10000;3:font5x7_row=5'b11110;4:font5x7_row=5'b10001;5:font5x7_row=5'b10001;default:font5x7_row=5'b01110;endcase
                "7": case(row) 0:font5x7_row=5'b11111;1:font5x7_row=5'b00001;2:font5x7_row=5'b00010;3:font5x7_row=5'b00100;4:font5x7_row=5'b01000;5:font5x7_row=5'b01000;default:font5x7_row=5'b01000;endcase
                "8": case(row) 0:font5x7_row=5'b01110;1:font5x7_row=5'b10001;2:font5x7_row=5'b10001;3:font5x7_row=5'b01110;4:font5x7_row=5'b10001;5:font5x7_row=5'b10001;default:font5x7_row=5'b01110;endcase
                "9": case(row) 0:font5x7_row=5'b01110;1:font5x7_row=5'b10001;2:font5x7_row=5'b10001;3:font5x7_row=5'b01111;4:font5x7_row=5'b00001;5:font5x7_row=5'b00001;default:font5x7_row=5'b01110;endcase
                "A": case(row) 0:font5x7_row=5'b01110;1:font5x7_row=5'b10001;2:font5x7_row=5'b10001;3:font5x7_row=5'b11111;4:font5x7_row=5'b10001;5:font5x7_row=5'b10001;default:font5x7_row=5'b10001;endcase
                "B": case(row) 0:font5x7_row=5'b11110;1:font5x7_row=5'b10001;2:font5x7_row=5'b10001;3:font5x7_row=5'b11110;4:font5x7_row=5'b10001;5:font5x7_row=5'b10001;default:font5x7_row=5'b11110;endcase
                "C": case(row) 0:font5x7_row=5'b01111;1:font5x7_row=5'b10000;2:font5x7_row=5'b10000;3:font5x7_row=5'b10000;4:font5x7_row=5'b10000;5:font5x7_row=5'b10000;default:font5x7_row=5'b01111;endcase
                "D": case(row) 0:font5x7_row=5'b11110;1:font5x7_row=5'b10001;2:font5x7_row=5'b10001;3:font5x7_row=5'b10001;4:font5x7_row=5'b10001;5:font5x7_row=5'b10001;default:font5x7_row=5'b11110;endcase
                "E": case(row) 0:font5x7_row=5'b11111;1:font5x7_row=5'b10000;2:font5x7_row=5'b10000;3:font5x7_row=5'b11110;4:font5x7_row=5'b10000;5:font5x7_row=5'b10000;default:font5x7_row=5'b11111;endcase
                "F": case(row) 0:font5x7_row=5'b11111;1:font5x7_row=5'b10000;2:font5x7_row=5'b10000;3:font5x7_row=5'b11110;4:font5x7_row=5'b10000;5:font5x7_row=5'b10000;default:font5x7_row=5'b10000;endcase
                "G": case(row) 0:font5x7_row=5'b01110;1:font5x7_row=5'b10001;2:font5x7_row=5'b10000;3:font5x7_row=5'b10111;4:font5x7_row=5'b10001;5:font5x7_row=5'b10001;default:font5x7_row=5'b01110;endcase
                "H": case(row) 0:font5x7_row=5'b10001;1:font5x7_row=5'b10001;2:font5x7_row=5'b10001;3:font5x7_row=5'b11111;4:font5x7_row=5'b10001;5:font5x7_row=5'b10001;default:font5x7_row=5'b10001;endcase
                "I": case(row) 0:font5x7_row=5'b01110;1:font5x7_row=5'b00100;2:font5x7_row=5'b00100;3:font5x7_row=5'b00100;4:font5x7_row=5'b00100;5:font5x7_row=5'b00100;default:font5x7_row=5'b01110;endcase
                "J": case(row) 0:font5x7_row=5'b00111;1:font5x7_row=5'b00010;2:font5x7_row=5'b00010;3:font5x7_row=5'b00010;4:font5x7_row=5'b10010;5:font5x7_row=5'b10010;default:font5x7_row=5'b01100;endcase
                "K": case(row) 0:font5x7_row=5'b10001;1:font5x7_row=5'b10010;2:font5x7_row=5'b10100;3:font5x7_row=5'b11000;4:font5x7_row=5'b10100;5:font5x7_row=5'b10010;default:font5x7_row=5'b10001;endcase
                "L": case(row) 0:font5x7_row=5'b10000;1:font5x7_row=5'b10000;2:font5x7_row=5'b10000;3:font5x7_row=5'b10000;4:font5x7_row=5'b10000;5:font5x7_row=5'b10000;default:font5x7_row=5'b11111;endcase
                "M": case(row) 0:font5x7_row=5'b10001;1:font5x7_row=5'b11011;2:font5x7_row=5'b10101;3:font5x7_row=5'b10101;4:font5x7_row=5'b10001;5:font5x7_row=5'b10001;default:font5x7_row=5'b10001;endcase
                "N": case(row) 0:font5x7_row=5'b10001;1:font5x7_row=5'b11001;2:font5x7_row=5'b10101;3:font5x7_row=5'b10011;4:font5x7_row=5'b10001;5:font5x7_row=5'b10001;default:font5x7_row=5'b10001;endcase
                "O": case(row) 0:font5x7_row=5'b01110;1:font5x7_row=5'b10001;2:font5x7_row=5'b10001;3:font5x7_row=5'b10001;4:font5x7_row=5'b10001;5:font5x7_row=5'b10001;default:font5x7_row=5'b01110;endcase
                "P": case(row) 0:font5x7_row=5'b11110;1:font5x7_row=5'b10001;2:font5x7_row=5'b10001;3:font5x7_row=5'b11110;4:font5x7_row=5'b10000;5:font5x7_row=5'b10000;default:font5x7_row=5'b10000;endcase
                "Q": case(row) 0:font5x7_row=5'b01110;1:font5x7_row=5'b10001;2:font5x7_row=5'b10001;3:font5x7_row=5'b10001;4:font5x7_row=5'b10101;5:font5x7_row=5'b10010;default:font5x7_row=5'b01101;endcase
                "R": case(row) 0:font5x7_row=5'b11110;1:font5x7_row=5'b10001;2:font5x7_row=5'b10001;3:font5x7_row=5'b11110;4:font5x7_row=5'b10100;5:font5x7_row=5'b10010;default:font5x7_row=5'b10001;endcase
                "S": case(row) 0:font5x7_row=5'b01111;1:font5x7_row=5'b10000;2:font5x7_row=5'b10000;3:font5x7_row=5'b01110;4:font5x7_row=5'b00001;5:font5x7_row=5'b00001;default:font5x7_row=5'b11110;endcase
                "T": case(row) 0:font5x7_row=5'b11111;1:font5x7_row=5'b00100;2:font5x7_row=5'b00100;3:font5x7_row=5'b00100;4:font5x7_row=5'b00100;5:font5x7_row=5'b00100;default:font5x7_row=5'b00100;endcase
                "U": case(row) 0:font5x7_row=5'b10001;1:font5x7_row=5'b10001;2:font5x7_row=5'b10001;3:font5x7_row=5'b10001;4:font5x7_row=5'b10001;5:font5x7_row=5'b10001;default:font5x7_row=5'b01110;endcase
                "V": case(row) 0:font5x7_row=5'b10001;1:font5x7_row=5'b10001;2:font5x7_row=5'b10001;3:font5x7_row=5'b10001;4:font5x7_row=5'b10001;5:font5x7_row=5'b01010;default:font5x7_row=5'b00100;endcase
                "W": case(row) 0:font5x7_row=5'b10001;1:font5x7_row=5'b10001;2:font5x7_row=5'b10001;3:font5x7_row=5'b10101;4:font5x7_row=5'b10101;5:font5x7_row=5'b10101;default:font5x7_row=5'b01010;endcase
                "X": case(row) 0:font5x7_row=5'b10001;1:font5x7_row=5'b10001;2:font5x7_row=5'b01010;3:font5x7_row=5'b00100;4:font5x7_row=5'b01010;5:font5x7_row=5'b10001;default:font5x7_row=5'b10001;endcase
                "Y": case(row) 0:font5x7_row=5'b10001;1:font5x7_row=5'b10001;2:font5x7_row=5'b01010;3:font5x7_row=5'b00100;4:font5x7_row=5'b00100;5:font5x7_row=5'b00100;default:font5x7_row=5'b00100;endcase
                "Z": case(row) 0:font5x7_row=5'b11111;1:font5x7_row=5'b00001;2:font5x7_row=5'b00010;3:font5x7_row=5'b00100;4:font5x7_row=5'b01000;5:font5x7_row=5'b10000;default:font5x7_row=5'b11111;endcase
                ":": case(row) 0:font5x7_row=5'b00000;1:font5x7_row=5'b00100;2:font5x7_row=5'b00100;3:font5x7_row=5'b00000;4:font5x7_row=5'b00100;5:font5x7_row=5'b00100;default:font5x7_row=5'b00000;endcase
                "?": case(row) 0:font5x7_row=5'b01110;1:font5x7_row=5'b10001;2:font5x7_row=5'b00010;3:font5x7_row=5'b00100;4:font5x7_row=5'b00100;5:font5x7_row=5'b00000;default:font5x7_row=5'b00100;endcase
                "/": case(row) 0:font5x7_row=5'b00001;1:font5x7_row=5'b00010;2:font5x7_row=5'b00010;3:font5x7_row=5'b00100;4:font5x7_row=5'b01000;5:font5x7_row=5'b01000;default:font5x7_row=5'b10000;endcase
                "+": case(row) 2:font5x7_row=5'b00100;3:font5x7_row=5'b11111;4:font5x7_row=5'b00100;default:font5x7_row=5'b00000;endcase
                default: font5x7_row=5'b00000;
            endcase
        end
    endfunction



    function [15:0] suit_row;
        input [2:0] suit;
        input [3:0] row;
        begin
            suit_row=16'b0;
            case(suit)
                SUIT_HEART: case(row) 1:suit_row=16'b0011100001110000;2:suit_row=16'b0111110011111000;3:suit_row=16'b1111111111111100;4:suit_row=16'b1111111111111100;5:suit_row=16'b1111111111111100;6:suit_row=16'b0111111111111000;7:suit_row=16'b0011111111110000;8:suit_row=16'b0001111111100000;9:suit_row=16'b0000111111000000;10:suit_row=16'b0000011110000000;11:suit_row=16'b0000001100000000;default:suit_row=16'b0;endcase
                SUIT_DIAMOND: case(row) 0:suit_row=16'b0000000100000000;1:suit_row=16'b0000001110000000;2:suit_row=16'b0000011111000000;3:suit_row=16'b0000111111100000;4:suit_row=16'b0001111111110000;5:suit_row=16'b0011111111111000;6:suit_row=16'b0111111111111100;7:suit_row=16'b1111111111111110;8:suit_row=16'b0111111111111100;9:suit_row=16'b0011111111111000;10:suit_row=16'b0001111111110000;11:suit_row=16'b0000111111100000;12:suit_row=16'b0000011111000000;13:suit_row=16'b0000001110000000;14:suit_row=16'b0000000100000000;default:suit_row=16'b0;endcase
                SUIT_SPADE: case(row) 0:suit_row=16'b0000000100000000;1:suit_row=16'b0000001110000000;2:suit_row=16'b0000011111000000;3:suit_row=16'b0000111111100000;4:suit_row=16'b0001111111110000;5:suit_row=16'b0011111111111000;6:suit_row=16'b0111111111111100;7:suit_row=16'b1111111111111110;8:suit_row=16'b1111111111111110;9:suit_row=16'b0111111111111100;10:suit_row=16'b0011111111111000;11:suit_row=16'b0000001110000000;12:suit_row=16'b0000001110000000;13:suit_row=16'b0000011111000000;14:suit_row=16'b0000111111100000;default:suit_row=16'b0;endcase
                SUIT_CLUB: case(row) 0:suit_row=16'b0000011100000000;1:suit_row=16'b0000111110000000;2:suit_row=16'b0000111110000000;3:suit_row=16'b0011101110111000;4:suit_row=16'b0111111111111100;5:suit_row=16'b0111111111111100;6:suit_row=16'b0011111111111000;7:suit_row=16'b0000111110000000;8:suit_row=16'b0000011100000000;9:suit_row=16'b0000011100000000;10:suit_row=16'b0000011100000000;11:suit_row=16'b0000111110000000;12:suit_row=16'b0001111111000000;default:suit_row=16'b0;endcase
                default: suit_row=16'b0;
            endcase
        end
    endfunction

    function draw_suit4;
        input [10:0] px, py, ox, oy;
        input [2:0] suit;
        integer sx, sy;
        reg [15:0] bits;
        begin
            draw_suit4=1'b0;
            if ((px>=ox)&&(px<ox+11'd64)&&(py>=oy)&&(py<oy+11'd64)) begin
                sx=(px-ox)>>2; sy=(py-oy)>>2; bits=suit_row(suit,sy[3:0]);
                draw_suit4=bits[15-sx];
            end
        end
    endfunction

    function [7:0] digit_ascii;
        input [3:0] d;
        begin digit_ascii = 8'h30 + d; end
    endfunction

    function [7:0] rank1;
        input [5:0] c;
        begin
            if(c<=3) rank1="1";
            else if(c<=7) rank1="2"; else if(c<=11) rank1="3"; else if(c<=15) rank1="4";
            else if(c<=19) rank1="5"; else if(c<=23) rank1="6"; else if(c<=27) rank1="7";
            else if(c<=31) rank1="8"; else if(c<=35) rank1="9"; else if(c<=39) rank1="A";
            else if(c<=45) rank1="J"; else if(c<=49) rank1="K"; else rank1="Q";
        end
    endfunction

    function [7:0] rank2;
        input [5:0] c;
        begin rank2 = (c<=3) ? "0" : " "; end
    endfunction

    function [2:0] card_suit;
        input [5:0] c;
        begin
            if(c<=43) card_suit=c[1:0];
            else if(c==44 || c==45) card_suit=SUIT_NONE;
            else if(c<=49) card_suit=(c-6'd46)&6'd3;
            else card_suit=(c-6'd50)&6'd3;
        end
    endfunction




 reg [23:0] color,ink,frame;
 reg [191:0] line;
 integer tx,ty,zoom,dx,dy,ci,gx,gy;
 integer row,col,lx,ly,idx;
 reg [5:0] cls;
 reg [1:0] state;
 reg [2:0] suit;
 reg [4:0] bits;
 reg [7:0] ch;
 reg [15:0] suit_bits;
 reg text_on,card_on,selected;
 reg [3:0] hun,ten,one;
 always @* begin
  color=BG;ink=LIGHT;frame=MUTED;line="                        ";
  tx=0;ty=0;zoom=0;text_on=0;card_on=0;selected=0;
  row=0;col=0;lx=0;ly=0;idx=0;cls=0;state=0;suit=SUIT_NONE;suit_bits=0;
  dx=0;dy=0;ci=0;gx=0;gy=0;ch=" ";bits=0;
  hun=turn_number/100;ten=(turn_number/10)%10;one=turn_number%10;
  // Clean navy panels, orange edge, pale cards: deliberately different to V8.
  if(x>=8 && x<272 && y>=28 && y<258) color=24'h1C2B43;
  if(x>=280 && x<472 && y>=8 && y<136) color=PANEL;
  if(x>=280 && x<282 && y>=8 && y<136) color=ORANGE;
  if(x>=280 && x<472 && y>=142 && y<264) color=PANEL;
  if(x>=287 && x<469 && y>=155 && y<259) color=CYAN;
  if(x>=288 && x<468 && y>=156 && y<258) color=24'h0A1222;
  if(x>=285 && x<469 && y>=38 && y<79) color=BG;
  if(x>=285 && x<469 && y>=98 && y<119) color=24'h344663;
  if(x>=288 && x<416 && y>=85 && y<89)
    color=(((x-288)>>4)<score)?ORANGE:24'h45556F;
  if(x>=288 && x<416 && y>=85 && y<89 && ((x-288)&15)>=14) color=PANEL;
  if(x<276) begin
   if(y>=9 && y<23) begin
    tx=12;ty=9;zoom=1;line="MEMORY / MATCH          ";text_on=1;ink=LIGHT;
   end
   if(y>=261 && y<268) begin
    tx=12;ty=261;line="ONE PLAYER. EIGHT PAIRS.";text_on=1;ink=MUTED;
   end
  end else begin
   text_on=1;tx=288;ink=LIGHT;
   if(y>=14 && y<28) begin ty=14;zoom=1;line="SINGLE PLAYER           ";ink=ORANGE;end
   else if(y>=42 && y<49) begin
    ty=42;ink=MUTED;
    if(x<350) begin tx=288;line="SCORE                   ";end
    else if(x<412) begin tx=352;line="LEFT                    ";end
    else begin tx=416;line="TURN                    ";end
   end else if(y>=53 && y<67) begin
    ty=53;zoom=1;
    if(x<350) begin tx=288;line="0/8                     ";line[191 -: 8]=digit_ascii(score);ink=ORANGE;end
    else if(x<412) begin
     tx=352;line="00                      ";line[191 -: 8]=remaining_cards>=10?"1":"0";
     line[183 -: 8]=digit_ascii(remaining_cards>=10?remaining_cards-10:remaining_cards);
    end else begin
     tx=416;line="000                     ";line[191 -: 8]=digit_ascii(hun);
     line[183 -: 8]=digit_ascii(ten);line[175 -: 8]=digit_ascii(one);
    end
   end else if(y>=71 && y<78) begin
    ty=71;ink=MUTED;
    if(x<350) begin tx=288;line="PAIRS                   ";end
    else if(x<412) begin tx=352;line="CARDS                   ";end
    else begin tx=416;line=turn_number==255?"255+                    ":"ROUND                   ";end
   end else if(y>=84 && y<91 && x>=424) begin
    tx=424;ty=84;line="0/8                     ";line[191 -: 8]=digit_ascii(score);ink=CYAN;
   end else if(y>=101 && y<108) begin
    ty=101;
    if(remaining_cards==0)begin line="ALL PAIRS FOUND         ";ink=CYAN;end
    else if(capture_busy)begin
     line="SCANNING A1  5S         ";ink=ORANGE;
     line[191-9*8 -: 8]="A"+capture_coord[3:2];
     line[191-10*8 -: 8]="1"+capture_coord[1:0];
     line[191-13*8 -: 8]=digit_ascii({1'b0,countdown_sec});
    end else if(result_state==1)begin line="MATCH / PLUS ONE        ";ink=CYAN;end
    else if(result_state==2)begin line="NO MATCH / TRY AGAIN    ";ink=ORANGE;end
    else line="CHOOSE YOUR NEXT PAIR   ";
   end else if(y>=111 && y<118) begin
    ty=111;ink=MUTED;
    if(remaining_cards==0)line="BOARD COMPLETE          ";
    else if(capture_busy)line="KEEP THE CARD STEADY    ";
    else if(result_state==2)line="TURN BOTH CARDS DOWN    ";
    else line="ENTER COORDINATE ON HPS ";
   end else if(y>=126 && y<133)begin ty=126;line="CLOSED FACES ARE MEMORY ";ink=MUTED;end
   else if(y>=147 && y<154)begin
    ty=147;line="LIVE / DETECTED:        ";ink=CYAN;
    if(detected_valid)begin
     if(detected_class==44)line="LIVE / JOKER B          ";
     else if(detected_class==45)line="LIVE / JOKER R          ";
     else begin
      line[191-16*8 -: 8]=rank1(detected_class);
      line[191-17*8 -: 8]=rank2(detected_class);
      case(card_suit(detected_class))
       0:line[191-19*8 -: 8]="C";
       1:line[191-19*8 -: 8]="D";
       2:line[191-19*8 -: 8]="H";
       3:line[191-19*8 -: 8]="S";
       default:line[191-19*8 -: 8]=" ";
      endcase
     end
    end
   end else text_on=0;
  end
  if(x>=12 && x<268 && y>=32 && y<256)begin
   col=(x-12)>>6;lx=(x-12)&63;
   if(y<88)begin row=0;ly=y-32;end
   else if(y<144)begin row=1;ly=y-88;end
   else if(y<200)begin row=2;ly=y-144;end
   else begin row=3;ly=y-200;end
   idx=row*4+col;cls=cards[idx*6 +: 6];state=states[idx*2 +: 2];suit=card_suit(cls);
   selected=capture_busy && capture_coord==idx;
   if(lx>=1 && lx<57 && ly>=2 && ly<54)color=24'h080F20;
   card_on=lx<56 && ly<52;
   if(card_on)begin
    text_on=0;
    frame=(state==3)?GREEN:((state==2 || selected)?ORANGE:24'h8797B0);
    color=frame;
    if(lx>0 && lx<55 && ly>0 && ly<51)begin
     if(state==0)begin
      color=24'h304562;
      if(((lx+ly)&7)==0)color=24'h3E5775;
      if(ly>=18 && ly<32)begin tx=col*64+12+23;ty=row*56+32+18;zoom=1;line="?                       ";text_on=1;ink=CYAN;end
     end else begin
      color=state==1?24'hBCC7D4:LIGHT;
      ink=(suit==1||suit==2||cls==45)?24'hC83E52:INK;
      if(cls!=44 && cls!=45)begin
       if(ly>=4 && ly<18)begin tx=col*64+16;ty=row*56+36;zoom=1;line="                        ";line[191 -: 8]=rank1(cls);line[183 -: 8]=rank2(cls);text_on=1;end
       if(lx>=20 && lx<36 && ly>=22 && ly<38)begin
        suit_bits=suit_row(suit,ly-22);if(suit_bits[15-(lx-20)])color=ink;
       end
      end else if(ly>=19 && ly<26)begin tx=col*64+12+13;ty=row*56+32+19;line="JOKER                   ";text_on=1;end
      else if(ly>=29 && ly<36)begin tx=col*64+12+25;ty=row*56+32+29;line=cls==45?"R                       ":"B                       ";text_on=1;end
      if(state==1 && ((lx+ly)&15)==0)color=24'h96A6B9;
     end
     if(ly>=42)begin
      color=frame;ink=INK;text_on=1;zoom=0;ty=row*56+32+44;
      if(lx<14)begin
       tx=col*64+12+2;line="A1                      ";line[191 -: 8]="A"+row;line[183 -: 8]="1"+col;
      end else begin
       tx=col*64+12+18;
       if(selected)line="SCAN                    ";else if(state==3)line="PAIRED                  ";
       else if(state==2)line="OPEN                    ";else if(state==1)line="CLOSED                  ";else line="HIDDEN                  ";
      end
     end
    end
   end
  end
  dx=x-tx;dy=y-ty;
  if(text_on && dx>=0 && dy>=0)begin
   ci=(dx>>zoom)/6;gx=(dx>>zoom)%6;gy=dy>>zoom;
   if(ci<24 && gx<5 && gy<7)begin
    ch=line[191-ci*8 -: 8];bits=font5x7_row(ch,gy);
    if(bits[4-gx])color=ink;
   end
  end
 end
 // Inputs are held for four render clocks; capture only on phase 3.
 // v9_timing.sdc constrains this specific path as setup=4 / hold=3.
 always @(posedge clk)if(enable)rgb<={color[23:19],color[15:10],color[7:3]};
endmodule
