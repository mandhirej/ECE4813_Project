`timescale 1ns/1ps
`default_nettype none

// ============================================================================
// CNN ACCELERATOR V10 - HPS-UPLOADED INPUT, ORIGINAL INFERENCE LAYERS
//
// Use the matching V10 DE10_Nano_D8M_DDR3 board-level top module.
// Replace the old cnn_accelerator_top and CNN-specific modules with this file.
//
// Required generated files from the Python exporter:
//   cnn_quant_config.vh
//   layer1_weights.vh
//   layer2_biases.vh
//   linear_bias.vh
//   weights_mac0.hex ... weights_mac7.hex
//   weights_linear.mif
//
// The quantized activation convention is:
//   q_activation / 255 ~= real activation
//
// Conv weights:
//   q_weight / 2^SHIFT ~= real weight
//
// Conv/FC bias:
//   q_bias ~= real_bias * 255 * 2^SHIFT
//
// IMPORTANT:
// - This version deliberately uses direct BRAM window reads for Layers 1/2.
//   This is slower than a streaming line-buffer architecture, but it removes
//   the timing/window-stability problems in the original design.
// - Layer 2 still uses 9 multipliers time-multiplexed over the 8 input
//   channels, while all 8 output filters operate in parallel.
// ============================================================================

// ----------------------------------------------------------------------------
// CDC helpers
// ----------------------------------------------------------------------------
module toggle_sync (
    input  wire clk_dst,
    input  wire reset_n,
    input  wire src_toggle,
    output reg  dst_pulse
);
    reg sync1, sync2, sync2_d;

    always @(posedge clk_dst or negedge reset_n) begin
        if (!reset_n) begin
            sync1    <= 1'b0;
            sync2    <= 1'b0;
            sync2_d  <= 1'b0;
            dst_pulse <= 1'b0;
        end else begin
            sync1     <= src_toggle;
            sync2     <= sync1;
            sync2_d   <= sync2;
            dst_pulse <= sync2 ^ sync2_d;
        end
    end
endmodule

module level_sync (
    input  wire clk_dst,
    input  wire reset_n,
    input  wire src_level,
    output reg  dst_level
);
    reg sync1;

    always @(posedge clk_dst or negedge reset_n) begin
        if (!reset_n) begin
            sync1     <= 1'b0;
            dst_level <= 1'b0;
        end else begin
            sync1     <= src_level;
            dst_level <= sync1;
        end
    end
endmodule

// ----------------------------------------------------------------------------
// Processed RGB video -> CNN pixel stream.
//
// Feed this module from the already processed clocked-video output of
// soc_system: disp_r/disp_g/disp_b/disp_de/disp_vs, clocked by HDMI_CLK.
// `data_enable` is the authoritative per-pixel valid signal, so no HSYNC-based
// pixel-valid reconstruction is required.
//
// Grayscale uses an 8-bit integer approximation to BT.601 / PIL luminance:
//   gray ~= 0.299 R + 0.587 G + 0.114 B
//        ~= (77R + 150G + 29B + 128) >> 8
// ----------------------------------------------------------------------------
module rgb_video_frontend #(
    parameter integer VS_ACTIVE_HIGH = 1
)(
    input  wire        clk,
    input  wire        reset_n,
    input  wire        vsync,
    input  wire        data_enable,
    input  wire [7:0]  pixel_R,
    input  wire [7:0]  pixel_G,
    input  wire [7:0]  pixel_B,

    output wire        pixel_valid,
    output wire        frame_start,
    output wire        line_start,
    output wire [10:0] pixel_x,
    output wire [10:0] pixel_y,
    output wire [7:0]  gray
);
    reg vs_d;
    reg de_d;
    reg line_seen;
    reg [10:0] x_count;
    reg [10:0] y_count;

    wire vs_active_now = VS_ACTIVE_HIGH ? vsync : ~vsync;
    wire vs_active_old = VS_ACTIVE_HIGH ? vs_d  : ~vs_d;
    wire de_rise       = data_enable && !de_d;

    assign frame_start = vs_active_now && !vs_active_old;
    assign line_start  = de_rise;
    assign pixel_valid = data_enable;

    // Coordinates correspond to the RGB sample currently present on the
    // clocked-video bus. The first DE cycle of each line is x=0.
    assign pixel_x = de_rise ? 11'd0 : x_count;
    assign pixel_y = de_rise ? (line_seen ? (y_count + 11'd1) : 11'd0)
                             : y_count;

    // Multiplier-free approximation of 0.299R + 0.587G + 0.114B.
    // 77 = 64+8+4+1, 150 = 128+16+4+2, 29 = 16+8+4+1.
    // This avoids spending FPGA DSP blocks on the video front end.
    wire [15:0] r_ext = {8'd0, pixel_R};
    wire [15:0] g_ext = {8'd0, pixel_G};
    wire [15:0] b_ext = {8'd0, pixel_B};

    wire [15:0] r_term = (r_ext << 6) + (r_ext << 3) + (r_ext << 2) + r_ext;
    wire [15:0] g_term = (g_ext << 7) + (g_ext << 4) + (g_ext << 2) + (g_ext << 1);
    wire [15:0] b_term = (b_ext << 4) + (b_ext << 3) + (b_ext << 2) + b_ext;
    wire [15:0] gray_sum = r_term + g_term + b_term + 16'd128;

    assign gray = gray_sum[15:8];

    always @(posedge clk or negedge reset_n) begin
        if (!reset_n) begin
            vs_d      <= VS_ACTIVE_HIGH ? 1'b0 : 1'b1;
            de_d      <= 1'b0;
            line_seen <= 1'b0;
            x_count   <= 11'd0;
            y_count   <= 11'd0;
        end else begin
            vs_d <= vsync;
            de_d <= data_enable;

            if (frame_start) begin
                line_seen <= 1'b0;
                x_count   <= 11'd0;
                y_count   <= 11'd0;
            end else if (de_rise) begin
                x_count <= 11'd1; // x=0 is being consumed this cycle.
                if (!line_seen) begin
                    line_seen <= 1'b1;
                    y_count   <= 11'd0;
                end else if (y_count != 11'd2047) begin
                    y_count <= y_count + 11'd1;
                end
            end else if (data_enable) begin
                if (x_count != 11'd2047)
                    x_count <= x_count + 11'd1;
            end
        end
    end
endmodule

// ----------------------------------------------------------------------------
// Camera/video cropper using explicit DE-derived pixel coordinates.
//
// Frame N is scouted for the bright foreground bounding box. Frame N+1 is
// captured using that box and downsampled to 64x64 with a simple DDA sampler.
// Explicit pixel_x/pixel_y remove the previous one-line coordinate ambiguity.
// ----------------------------------------------------------------------------
module hardware_cropper_fixed #(
    parameter integer OUT_SIZE       = 64,
    parameter integer THRESHOLD      = 80,
    parameter integer MIN_BRIGHT_RUN = 64
)(
    input  wire        clk,
    input  wire        reset_n,

    input  wire        frame_start,
    input  wire        line_start,
    input  wire        pixel_valid,
    input  wire [10:0] pixel_x,
    input  wire [10:0] pixel_y,
    input  wire [7:0]  gray,

    input  wire        cnn_busy_cam,

    output reg         frame_ready_toggle,
    output reg         bram_we,
    output reg  [11:0] bram_addr,
    output reg  [7:0]  bram_data,

    // Stable bounding box used for the capture frame. These outputs are
    // latched when a scout frame completes and remain unchanged while the
    // corresponding 64x64 crop is captured and classified.
    output reg         bbox_out_valid,
    output reg  [10:0] bbox_out_min_x,
    output reg  [10:0] bbox_out_max_x,
    output reg  [10:0] bbox_out_min_y,
    output reg  [10:0] bbox_out_max_y
);

    // ============================================================
    // State machine
    // ============================================================
    localparam S_IDLE    = 2'd0;
    localparam S_SCOUT   = 2'd1;
    localparam S_CAPTURE = 2'd2;
    localparam S_WAIT    = 2'd3;

    reg [1:0] state;

    // ============================================================
    // Bounding box
    // ============================================================
    reg [10:0] min_x;
    reg [10:0] max_x;
    reg [10:0] min_y;
    reg [10:0] max_y;

    reg [11:0] W;
    reg [11:0] H;

    reg bbox_valid;

    // ============================================================
    // Dedicated cropper input pipeline
    // ============================================================
    // rgb_video_frontend performs DE coordinate reconstruction and RGB->gray
    // conversion.  Register ALL of those outputs together before the cropper
    // performs run detection, bbox updates, or DDA capture.  This creates a
    // hard timing boundary between the video front end and cropper logic.
    //
    // The one-pixel latency does not alter geometry because valid, line/frame
    // markers, x/y and gray are delayed together.
    (* preserve *) reg        crop_frame_start;
    (* preserve *) reg        crop_line_start;
    (* preserve *) reg        crop_pixel_valid;
    (* preserve *) reg [10:0] crop_pixel_x;
    (* preserve *) reg [10:0] crop_pixel_y;
    (* preserve *) reg [7:0]  crop_gray;

    always @(posedge clk or negedge reset_n) begin
        if (!reset_n) begin
            crop_frame_start <= 1'b0;
            crop_line_start  <= 1'b0;
            crop_pixel_valid <= 1'b0;
            crop_pixel_x     <= 11'd0;
            crop_pixel_y     <= 11'd0;
            crop_gray        <= 8'd0;
        end else begin
            crop_frame_start <= frame_start;
            crop_line_start  <= line_start;
            crop_pixel_valid <= pixel_valid;
            crop_pixel_x     <= pixel_x;
            crop_pixel_y     <= pixel_y;
            crop_gray        <= gray;
        end
    end

    // ============================================================
    // Bright-run detector
    //
    // A single bright pixel is NOT enough to modify the bounding
    // box anymore.
    //
    // A horizontal run must contain at least MIN_BRIGHT_RUN
    // consecutive pixels with:
    //      gray > THRESHOLD
    // before it is considered part of the card.
    // ============================================================
    reg [10:0] bright_run_len;
    reg [10:0] bright_run_start_x;
    reg        run_qualified;

    wire is_bright = (crop_gray > THRESHOLD);

    // ============================================================
    // 64x64 DDA resize state
    // ============================================================
    reg [11:0] x_acc;
    reg [11:0] y_acc;

    reg [6:0] out_x;
    reg [6:0] out_y;

    reg [6:0] row_out_y;
    reg       row_enable;

    // ============================================================
    // DDA row-selection logic
    // ============================================================
    wire row_should_take = 
        bbox_valid &&
        (crop_pixel_y >= min_y) &&
        (crop_pixel_y <= max_y) &&
        (out_y < OUT_SIZE) &&
        ((y_acc + OUT_SIZE) >= H);

    wire effective_row_enable = crop_line_start ? row_should_take : row_enable;
    wire [6:0]  effective_row_y  = crop_line_start ? out_y : row_out_y;
    wire [11:0] effective_x_acc  = crop_line_start ? 12'd0 : x_acc;
    wire [6:0]  effective_out_x  = crop_line_start ? 7'd0 : out_x;

    // ============================================================
    // Main state machine
    // ============================================================
    always @(posedge clk or negedge reset_n) begin
        if (!reset_n) begin
            state              <= S_IDLE;
            frame_ready_toggle <= 1'b0;
            bram_we            <= 1'b0;
            bram_addr          <= 12'd0;
            bram_data          <= 8'd0;

            // Bounding box reset
            min_x              <= 11'd2047;
            max_x              <= 11'd0;
            min_y              <= 11'd2047;
            max_y              <= 11'd0;
            W                  <= 12'd0;
            H                  <= 12'd0;
            bbox_valid         <= 1'b0;
            bbox_out_valid     <= 1'b0;
            bbox_out_min_x     <= 11'd0;
            bbox_out_max_x     <= 11'd0;
            bbox_out_min_y     <= 11'd0;
            bbox_out_max_y     <= 11'd0;

            // Bright-run detector reset
            bright_run_len     <= 11'd0;
            bright_run_start_x <= 11'd0;
            run_qualified      <= 1'b0;

            // DDA reset
            x_acc              <= 12'd0;
            y_acc              <= 12'd0;
            out_x              <= 7'd0;
            out_y              <= 7'd0;
            row_out_y          <= 7'd0;
            row_enable         <= 1'b0;
        end else begin
            // Default: no crop RAM write this cycle
            bram_we <= 1'b0;

            case (state)
                // ==================================================
                // IDLE
                // ==================================================
                S_IDLE: begin
                    if (crop_frame_start && !cnn_busy_cam) begin
                        // Start a completely fresh scout frame.
                        min_x <= 11'd2047;
                        max_x <= 11'd0;
                        min_y <= 11'd2047;
                        max_y <= 11'd0;

                        W          <= 12'd0;
                        H          <= 12'd0;
                        bbox_valid <= 1'b0;

                        // Reset bright-run detector.
                        bright_run_len     <= 11'd0;
                        bright_run_start_x <= 11'd0;
                        run_qualified      <= 1'b0;

                        state <= S_SCOUT;
                    end
                end

                // ==================================================
                // SCOUT
                //
                // Find substantial horizontal bright regions.
                //
                // Previously:
                //   EVERY crop_gray > THRESHOLD pixel changed min/max.
                // Therefore one noisy pixel near x=0 and another
                // near x=1919 produced a full-screen bounding box.
                //
                // Now:
                //   A horizontal run must first reach MIN_BRIGHT_RUN pixels.
                // Once qualified, the entire run contributes to the bounding box.
                // ==================================================
                S_SCOUT: begin
                    // ------------------------------------------------
                    // Process active video pixels
                    // ------------------------------------------------
                    if (crop_pixel_valid) begin
                        // --------------------------------------------
                        // First valid pixel of a new video line
                        // --------------------------------------------
                        if (crop_line_start) begin
                            run_qualified <= 1'b0;
                            if (is_bright) begin
                                bright_run_len     <= 11'd1;
                                bright_run_start_x <= crop_pixel_x;
                            end else begin
                                bright_run_len     <= 11'd0;
                                bright_run_start_x <= 11'd0;
                            end
                        end
                        // --------------------------------------------
                        // Rest of the line
                        // --------------------------------------------
                        else begin
                            if (is_bright) begin
                                // ====================================
                                // Already-qualified bright run
                                // ====================================
                                if (run_qualified) begin
                                    // Keep extending the right edge.
                                    if (crop_pixel_x > max_x) max_x <= crop_pixel_x;

                                    // This row belongs to a valid foreground region.
                                    if (crop_pixel_y < min_y) min_y <= crop_pixel_y;
                                    if (crop_pixel_y > max_y) max_y <= crop_pixel_y;

                                    // Saturate the run counter once qualified.
                                    // Exact length is no longer important.
                                    bright_run_len <= bright_run_len;
                                end
                                // ====================================
                                // Current pixel makes the run long enough to become valid
                                // ====================================
                                else if (bright_run_len >= (MIN_BRIGHT_RUN - 1)) begin
                                    run_qualified <= 1'b1;

                                    // Include the START of the run, not merely 
                                    // the pixel where it reached MIN_BRIGHT_RUN samples.
                                    if (bright_run_start_x < min_x) min_x <= bright_run_start_x;
                                    if (crop_pixel_x > max_x) max_x <= crop_pixel_x;

                                    // Current row now contains a sufficiently large bright region.
                                    if (crop_pixel_y < min_y) min_y <= crop_pixel_y;
                                    if (crop_pixel_y > max_y) max_y <= crop_pixel_y;

                                    // Saturate at MIN_BRIGHT_RUN.
                                    bright_run_len <= MIN_BRIGHT_RUN;
                                end
                                // ====================================
                                // Bright, but the run is still too short
                                // ====================================
                                else begin
                                    // If this is the first bright pixel after a dark region,
                                    // remember where the run started.
                                    if (bright_run_len == 0) bright_run_start_x <= crop_pixel_x;
                                    bright_run_len <= bright_run_len + 11'd1;
                                end
                            end
                            // ----------------------------------------
                            // Dark pixel terminates current run
                            // ----------------------------------------
                            else begin
                                bright_run_len     <= 11'd0;
                                bright_run_start_x <= 11'd0;
                                run_qualified      <= 1'b0;
                            end
                        end
                    end

                    // ------------------------------------------------
                    // Next frame begins:
                    // Previous scout frame is complete. Validate bounding 
                    // box and prepare capture.
                    // ------------------------------------------------
                    if (crop_frame_start) begin
                        if ((max_x >= min_x) && (max_y >= min_y) &&
                            ((max_x - min_x + 1'b1) >= OUT_SIZE) &&
                            ((max_y - min_y + 1'b1) >= OUT_SIZE)) begin
                            
                            W <= max_x - min_x + 1'b1;
                            H <= max_y - min_y + 1'b1;
                            bbox_valid     <= 1'b1;
                            bbox_out_valid <= 1'b1;
                            bbox_out_min_x <= min_x;
                            bbox_out_max_x <= max_x;
                            bbox_out_min_y <= min_y;
                            bbox_out_max_y <= max_y;
                        end else begin
                            W              <= 12'd0;
                            H              <= 12'd0;
                            bbox_valid     <= 1'b0;
                            bbox_out_valid <= 1'b0;
                            bbox_out_min_x <= 11'd0;
                            bbox_out_max_x <= 11'd0;
                            bbox_out_min_y <= 11'd0;
                            bbox_out_max_y <= 11'd0;
                        end

                        // Reset DDA state for capture frame.
                        x_acc      <= 12'd0;
                        y_acc      <= 12'd0;
                        out_x      <= 7'd0;
                        out_y      <= 7'd0;
                        row_out_y  <= 7'd0;
                        row_enable <= 1'b0;

                        // Reset scout-only state.
                        bright_run_len     <= 11'd0;
                        bright_run_start_x <= 11'd0;
                        run_qualified      <= 1'b0;

                        state <= S_CAPTURE;
                    end
                end

                // ==================================================
                // CAPTURE
                // Same DDA downsampling logic as before.
                // ==================================================
                S_CAPTURE: begin
                    // ------------------------------------------------
                    // At the first active pixel of each source row,
                    // decide whether this row becomes one of the
                    // 64 output rows.
                    // ------------------------------------------------
                    if (crop_line_start) begin
                        x_acc <= 12'd0;
                        out_x <= 7'd0;

                        if (bbox_valid &&
                            (crop_pixel_y >= min_y) &&
                            (crop_pixel_y <= max_y) &&
                            (out_y < OUT_SIZE)) begin

                            if ((y_acc + OUT_SIZE) >= H) begin
                                y_acc      <= (y_acc + OUT_SIZE) - H;
                                row_enable <= 1'b1;
                                row_out_y  <= out_y;
                                out_y      <= out_y + 1'b1;
                            end else begin
                                y_acc      <= y_acc + OUT_SIZE;
                                row_enable <= 1'b0;
                            end
                        end else begin
                            row_enable <= 1'b0;
                        end
                    end

                    // ------------------------------------------------
                    // Horizontal DDA
                    // Only operates inside the detected bounding box.
                    // ------------------------------------------------
                    if (bbox_valid && crop_pixel_valid && effective_row_enable &&
                        (crop_pixel_x >= min_x) && (crop_pixel_x <= max_x) &&
                        (effective_out_x < OUT_SIZE)) begin

                        if ((effective_x_acc + OUT_SIZE) >= W) begin
                            x_acc     <= (effective_x_acc + OUT_SIZE) - W;
                            bram_we   <= 1'b1;
                            bram_addr <= {effective_row_y[5:0], effective_out_x[5:0]};
                            bram_data <= crop_gray;
                            out_x     <= effective_out_x + 1'b1;
                        end else begin
                            x_acc <= effective_x_acc + OUT_SIZE;
                        end
                    end

                    // ------------------------------------------------
                    // End of capture frame
                    // ------------------------------------------------
                    if (crop_frame_start) begin
                        if (bbox_valid) begin
                            frame_ready_toggle <= ~frame_ready_toggle;
                            state <= S_WAIT;
                        end else begin
                            state <= S_IDLE;
                        end
                    end
                end

                // ==================================================
                // WAIT
                // ==================================================
                S_WAIT: begin
                    // Wait until CNN starts consuming the crop.
                    if (cnn_busy_cam) begin
                        state <= S_IDLE;
                    end
                end

                // ==================================================
                // Safety default
                // ==================================================
                default: begin
                    state <= S_IDLE;
                end
            endcase
        end
    end

endmodule

// ----------------------------------------------------------------------------
// Dual-clock 64x64 image RAM
// ----------------------------------------------------------------------------
module cropper_bram (
    input  wire       clk_camera,
    input  wire       we,
    input  wire [11:0] write_addr,
    input  wire [7:0]  write_data,

    input  wire       clk_cnn,
    input  wire       re,
    input  wire [11:0] read_addr,
    output reg  [7:0]  read_data
);
    (* ramstyle = "M10K" *) reg [7:0] memory [0:4095];

    always @(posedge clk_camera) begin
        if (we)
            memory[write_addr] <= write_data;
    end

    always @(posedge clk_cnn) begin
        if (re)
            read_data <= memory[read_addr];
    end
endmodule

// ----------------------------------------------------------------------------
// Layer-1 single-window MAC.
// One registered result cycle after start.
// ----------------------------------------------------------------------------
// conv_3x3_mac_fixed removed: functionality is time-multiplexed inside the bank below.

// ----------------------------------------------------------------------------
// Layer-1 8-filter bank.
// ----------------------------------------------------------------------------
module layer1_mac_bank #(
    parameter integer SHIFT = 7
)(
    input  wire clk,
    input  wire reset_n,
    input  wire start,
    input  wire [7:0] p11,p12,p13,p21,p22,p23,p31,p32,p33,
    output reg  [7:0] ch0,ch1,ch2,ch3,ch4,ch5,ch6,ch7,
    output reg        valid_out
);
    // Same quantized model as before, but ONE multiplier is reused for all
    // 8 filters x 9 kernel taps. This dramatically reduces DSP usage.
    `include "layer1_weights.vh"

    reg busy;
    reg [2:0] filter_idx;
    reg [3:0] tap_idx;
    reg signed [31:0] accumulator;

    // Hold the complete 3x3 input window until all 8 filters are finished.
    reg [7:0] rp11,rp12,rp13,rp21,rp22,rp23,rp31,rp32,rp33;

    reg [7:0] pixel_sel;
    reg signed [7:0] weight_sel;
    reg signed [31:0] bias_sel;

    // Select one pixel, one weight and one bias each cycle.
    always @(*) begin
        case (tap_idx)
            4'd0: pixel_sel = rp11;
            4'd1: pixel_sel = rp12;
            4'd2: pixel_sel = rp13;
            4'd3: pixel_sel = rp21;
            4'd4: pixel_sel = rp22;
            4'd5: pixel_sel = rp23;
            4'd6: pixel_sel = rp31;
            4'd7: pixel_sel = rp32;
            default: pixel_sel = rp33;
        endcase

        weight_sel = 8'sd0;
        bias_sel   = 32'sd0;

        case (filter_idx)
            3'd0: begin
                bias_sel = f0_bias;
                case(tap_idx)
                    0:weight_sel=f0_w11; 1:weight_sel=f0_w12; 2:weight_sel=f0_w13;
                    3:weight_sel=f0_w21; 4:weight_sel=f0_w22; 5:weight_sel=f0_w23;
                    6:weight_sel=f0_w31; 7:weight_sel=f0_w32; default:weight_sel=f0_w33;
                endcase
            end
            3'd1: begin
                bias_sel = f1_bias;
                case(tap_idx)
                    0:weight_sel=f1_w11; 1:weight_sel=f1_w12; 2:weight_sel=f1_w13;
                    3:weight_sel=f1_w21; 4:weight_sel=f1_w22; 5:weight_sel=f1_w23;
                    6:weight_sel=f1_w31; 7:weight_sel=f1_w32; default:weight_sel=f1_w33;
                endcase
            end
            3'd2: begin
                bias_sel = f2_bias;
                case(tap_idx)
                    0:weight_sel=f2_w11; 1:weight_sel=f2_w12; 2:weight_sel=f2_w13;
                    3:weight_sel=f2_w21; 4:weight_sel=f2_w22; 5:weight_sel=f2_w23;
                    6:weight_sel=f2_w31; 7:weight_sel=f2_w32; default:weight_sel=f2_w33;
                endcase
            end
            3'd3: begin
                bias_sel = f3_bias;
                case(tap_idx)
                    0:weight_sel=f3_w11; 1:weight_sel=f3_w12; 2:weight_sel=f3_w13;
                    3:weight_sel=f3_w21; 4:weight_sel=f3_w22; 5:weight_sel=f3_w23;
                    6:weight_sel=f3_w31; 7:weight_sel=f3_w32; default:weight_sel=f3_w33;
                endcase
            end
            3'd4: begin
                bias_sel = f4_bias;
                case(tap_idx)
                    0:weight_sel=f4_w11; 1:weight_sel=f4_w12; 2:weight_sel=f4_w13;
                    3:weight_sel=f4_w21; 4:weight_sel=f4_w22; 5:weight_sel=f4_w23;
                    6:weight_sel=f4_w31; 7:weight_sel=f4_w32; default:weight_sel=f4_w33;
                endcase
            end
            3'd5: begin
                bias_sel = f5_bias;
                case(tap_idx)
                    0:weight_sel=f5_w11; 1:weight_sel=f5_w12; 2:weight_sel=f5_w13;
                    3:weight_sel=f5_w21; 4:weight_sel=f5_w22; 5:weight_sel=f5_w23;
                    6:weight_sel=f5_w31; 7:weight_sel=f5_w32; default:weight_sel=f5_w33;
                endcase
            end
            3'd6: begin
                bias_sel = f6_bias;
                case(tap_idx)
                    0:weight_sel=f6_w11; 1:weight_sel=f6_w12; 2:weight_sel=f6_w13;
                    3:weight_sel=f6_w21; 4:weight_sel=f6_w22; 5:weight_sel=f6_w23;
                    6:weight_sel=f6_w31; 7:weight_sel=f6_w32; default:weight_sel=f6_w33;
                endcase
            end
            default: begin
                bias_sel = f7_bias;
                case(tap_idx)
                    0:weight_sel=f7_w11; 1:weight_sel=f7_w12; 2:weight_sel=f7_w13;
                    3:weight_sel=f7_w21; 4:weight_sel=f7_w22; 5:weight_sel=f7_w23;
                    6:weight_sel=f7_w31; 7:weight_sel=f7_w32; default:weight_sel=f7_w33;
                endcase
            end
        endcase
    end

    // Exactly one variable 9x8-bit multiply is present in this module.
    wire signed [16:0] product = $signed({1'b0,pixel_sel}) * weight_sel;
    wire signed [31:0] product_ext = {{15{product[16]}}, product};
    wire signed [31:0] final_sum = accumulator + product_ext + bias_sel;
    wire signed [31:0] shifted   = final_sum >>> SHIFT;

    always @(posedge clk or negedge reset_n) begin
        if (!reset_n) begin
            busy        <= 1'b0;
            filter_idx  <= 3'd0;
            tap_idx     <= 4'd0;
            accumulator <= 32'sd0;
            valid_out   <= 1'b0;
            ch0<=0;ch1<=0;ch2<=0;ch3<=0;ch4<=0;ch5<=0;ch6<=0;ch7<=0;
            rp11<=0;rp12<=0;rp13<=0;rp21<=0;rp22<=0;rp23<=0;rp31<=0;rp32<=0;rp33<=0;
        end else begin
            valid_out <= 1'b0;

            if (start && !busy) begin
                rp11<=p11; rp12<=p12; rp13<=p13;
                rp21<=p21; rp22<=p22; rp23<=p23;
                rp31<=p31; rp32<=p32; rp33<=p33;
                filter_idx  <= 3'd0;
                tap_idx     <= 4'd0;
                accumulator <= 32'sd0;
                busy        <= 1'b1;
            end else if (busy) begin
                if (tap_idx == 4'd8) begin
                    // Last tap for this filter: add bias, requantize, save.
                    case (filter_idx)
                        3'd0: ch0 <= (final_sum < 0) ? 8'd0 : ((shifted > 255) ? 8'd255 : shifted[7:0]);
                        3'd1: ch1 <= (final_sum < 0) ? 8'd0 : ((shifted > 255) ? 8'd255 : shifted[7:0]);
                        3'd2: ch2 <= (final_sum < 0) ? 8'd0 : ((shifted > 255) ? 8'd255 : shifted[7:0]);
                        3'd3: ch3 <= (final_sum < 0) ? 8'd0 : ((shifted > 255) ? 8'd255 : shifted[7:0]);
                        3'd4: ch4 <= (final_sum < 0) ? 8'd0 : ((shifted > 255) ? 8'd255 : shifted[7:0]);
                        3'd5: ch5 <= (final_sum < 0) ? 8'd0 : ((shifted > 255) ? 8'd255 : shifted[7:0]);
                        3'd6: ch6 <= (final_sum < 0) ? 8'd0 : ((shifted > 255) ? 8'd255 : shifted[7:0]);
                        default: ch7 <= (final_sum < 0) ? 8'd0 : ((shifted > 255) ? 8'd255 : shifted[7:0]);
                    endcase

                    if (filter_idx == 3'd7) begin
                        busy      <= 1'b0;
                        valid_out <= 1'b1;
                        filter_idx<= 3'd0;
                        tap_idx   <= 4'd0;
                        accumulator <= 32'sd0;
                    end else begin
                        filter_idx  <= filter_idx + 1'b1;
                        tap_idx     <= 4'd0;
                        accumulator <= 32'sd0;
                    end
                end else begin
                    accumulator <= accumulator + product_ext;
                    tap_idx     <= tap_idx + 1'b1;
                end
            end
        end
    end
endmodule

// ----------------------------------------------------------------------------
// Layer-1 direct-window controller.
// It evaluates all 32x32 output locations. Each output uses nine synchronous
// BRAM reads, then one Layer-1 MAC-bank operation.
// ----------------------------------------------------------------------------
module layer1_controller (
    input  wire clk,
    input  wire reset_n,
    input  wire start,
    output reg  done,

    output wire bram_en,
    output wire [11:0] bram_addr,
    input  wire [7:0] bram_data,

    output reg mac_start,
    output reg [7:0] p11,p12,p13,p21,p22,p23,p31,p32,p33,
    input  wire mac_valid,

    output wire ping_we,
    output wire [9:0] ping_addr
);
    localparam S_IDLE      = 3'd0;
    localparam S_READ_REQ  = 3'd1;
    localparam S_READ_WAIT = 3'd2;
    localparam S_MAC       = 3'd3;
    localparam S_WAIT_MAC  = 3'd4;

    reg [2:0] state;
    reg [5:0] out_x, out_y;
    reg [3:0] read_index;

    reg signed [8:0] src_x;
    reg signed [8:0] src_y;
    reg               coord_valid;

    always @(*) begin
        case (read_index)
            4'd0: begin src_x = ($signed({1'b0,out_x}) <<< 1) - 1; src_y = ($signed({1'b0,out_y}) <<< 1) - 1; end
            4'd1: begin src_x = ($signed({1'b0,out_x}) <<< 1);     src_y = ($signed({1'b0,out_y}) <<< 1) - 1; end
            4'd2: begin src_x = ($signed({1'b0,out_x}) <<< 1) + 1; src_y = ($signed({1'b0,out_y}) <<< 1) - 1; end
            4'd3: begin src_x = ($signed({1'b0,out_x}) <<< 1) - 1; src_y = ($signed({1'b0,out_y}) <<< 1);     end
            4'd4: begin src_x = ($signed({1'b0,out_x}) <<< 1);     src_y = ($signed({1'b0,out_y}) <<< 1);     end
            4'd5: begin src_x = ($signed({1'b0,out_x}) <<< 1) + 1; src_y = ($signed({1'b0,out_y}) <<< 1);     end
            4'd6: begin src_x = ($signed({1'b0,out_x}) <<< 1) - 1; src_y = ($signed({1'b0,out_y}) <<< 1) + 1; end
            4'd7: begin src_x = ($signed({1'b0,out_x}) <<< 1);     src_y = ($signed({1'b0,out_y}) <<< 1) + 1; end
            default: begin src_x = ($signed({1'b0,out_x}) <<< 1) + 1; src_y = ($signed({1'b0,out_y}) <<< 1) + 1; end
        endcase
        coord_valid = (src_x >= 0) && (src_x < 64) &&
                      (src_y >= 0) && (src_y < 64);
    end

    assign bram_en   = (state == S_READ_REQ) && coord_valid;
    assign bram_addr = coord_valid ? {src_y[5:0], src_x[5:0]} : 12'd0;

    assign ping_we   = (state == S_WAIT_MAC) && mac_valid;
    assign ping_addr = {out_y[4:0], out_x[4:0]};

    always @(posedge clk or negedge reset_n) begin
        if (!reset_n) begin
            state       <= S_IDLE;
            done        <= 1'b0;
            mac_start   <= 1'b0;
            out_x       <= 0;
            out_y       <= 0;
            read_index  <= 0;
            p11<=0;p12<=0;p13<=0;p21<=0;p22<=0;p23<=0;p31<=0;p32<=0;p33<=0;
        end else begin
            done      <= 1'b0;
            mac_start <= 1'b0;

            case (state)
                S_IDLE: begin
                    if (start) begin
                        out_x      <= 0;
                        out_y      <= 0;
                        read_index <= 0;
                        state      <= S_READ_REQ;
                    end
                end

                S_READ_REQ: begin
                    if (coord_valid) begin
                        state     <= S_READ_WAIT;
                    end else begin
                        case (read_index)
                            4'd0: p11 <= 8'd0;
                            4'd1: p12 <= 8'd0;
                            4'd2: p13 <= 8'd0;
                            4'd3: p21 <= 8'd0;
                            4'd4: p22 <= 8'd0;
                            4'd5: p23 <= 8'd0;
                            4'd6: p31 <= 8'd0;
                            4'd7: p32 <= 8'd0;
                            default: p33 <= 8'd0;
                        endcase

                        if (read_index == 8) begin
                            state <= S_MAC;
                        end else begin
                            read_index <= read_index + 1'b1;
                        end
                    end
                end

                S_READ_WAIT: begin
                    case (read_index)
                        4'd0: p11 <= bram_data;
                        4'd1: p12 <= bram_data;
                        4'd2: p13 <= bram_data;
                        4'd3: p21 <= bram_data;
                        4'd4: p22 <= bram_data;
                        4'd5: p23 <= bram_data;
                        4'd6: p31 <= bram_data;
                        4'd7: p32 <= bram_data;
                        default: p33 <= bram_data;
                    endcase

                    if (read_index == 8) begin
                        state <= S_MAC;
                    end else begin
                        read_index <= read_index + 1'b1;
                        state <= S_READ_REQ;
                    end
                end

                S_MAC: begin
                    mac_start <= 1'b1;
                    state <= S_WAIT_MAC;
                end

                S_WAIT_MAC: begin
                    if (mac_valid) begin
                        if ((out_x == 31) && (out_y == 31)) begin
                            state <= S_IDLE;
                            done  <= 1'b1;
                        end else if (out_x == 31) begin
                            out_x      <= 0;
                            out_y      <= out_y + 1'b1;
                            read_index <= 0;
                            state      <= S_READ_REQ;
                        end else begin
                            out_x      <= out_x + 1'b1;
                            read_index <= 0;
                            state      <= S_READ_REQ;
                        end
                    end
                end

                default: state <= S_IDLE;
            endcase
        end
    end
endmodule

// ----------------------------------------------------------------------------
// Ping RAM: 32x32x8
// ----------------------------------------------------------------------------
module ping_ram_fixed (
    input wire clk,
    input wire we,
    input wire [9:0] write_addr,
    input wire [7:0] ch0_in,ch1_in,ch2_in,ch3_in,ch4_in,ch5_in,ch6_in,ch7_in,
    input wire re,
    input wire [9:0] read_addr,
    output reg [63:0] read_data
);
    (* ramstyle = "M10K" *) reg [63:0] memory [0:1023];
    wire [63:0] packed_write_data = {ch7_in,ch6_in,ch5_in,ch4_in,ch3_in,ch2_in,ch1_in,ch0_in};

    always @(posedge clk) begin
        if (we)
            memory[write_addr] <= packed_write_data;
        if (re)
            read_data <= memory[read_addr];
    end
endmodule

// ----------------------------------------------------------------------------
// Layer-2 weight manager.
// Each .hex file contains 18 words: 9 kernel positions for pass 0 and 9 for
// pass 1. Each word packs {ch7,...,ch0}.
// ----------------------------------------------------------------------------
module layer2_weight_manager #(
    parameter HEX_FILE = "weights_mac0.hex"
)(
    input wire clk,
    input wire reset_n,
    input wire load_en,
    input wire pass_number,
    output reg [63:0] w11,w12,w13,w21,w22,w23,w31,w32,w33
);
    reg [63:0] rom [0:17];
    reg [3:0] load_counter;
    wire [4:0] base_addr = pass_number ? 5'd9 : 5'd0;

    initial begin
        $readmemh(HEX_FILE, rom);
    end

    always @(posedge clk or negedge reset_n) begin
        if (!reset_n) begin
            load_counter <= 0;
            w11<=0;w12<=0;w13<=0;w21<=0;w22<=0;w23<=0;w31<=0;w32<=0;w33<=0;
        end else if (load_en) begin
            case (load_counter)
                4'd0: w11 <= rom[base_addr + 0];
                4'd1: w12 <= rom[base_addr + 1];
                4'd2: w13 <= rom[base_addr + 2];
                4'd3: w21 <= rom[base_addr + 3];
                4'd4: w22 <= rom[base_addr + 4];
                4'd5: w23 <= rom[base_addr + 5];
                4'd6: w31 <= rom[base_addr + 6];
                4'd7: w32 <= rom[base_addr + 7];
                4'd8: w33 <= rom[base_addr + 8];
                default: ;
            endcase
            if (load_counter < 9)
                load_counter <= load_counter + 1'b1;
        end else begin
            load_counter <= 0;
        end
    end
endmodule

// ----------------------------------------------------------------------------
// Correct Layer-2 serialized MAC.
// The complete 3x3x8 window is latched at start and held for all 8 channel
// cycles. Weights are read from the actual weight inputs, not the pixel data.
// Bias is added exactly once.
// ----------------------------------------------------------------------------
// conv_layer2_mac_fixed removed: functionality is time-multiplexed inside the bank below.

// ----------------------------------------------------------------------------
// Layer-2 8-output-filter bank.
// ----------------------------------------------------------------------------
module layer2_mac_bank #(
    parameter integer SHIFT = 7
)(
    input  wire clk,
    input  wire reset_n,
    input  wire load_en,
    input  wire pass_number,
    input  wire start,
    input  wire [63:0] p11,p12,p13,p21,p22,p23,p31,p32,p33,
    output reg  [7:0] ch0,ch1,ch2,ch3,ch4,ch5,ch6,ch7,
    output reg        mac_valid,
    output wire       mac_busy
);
    // Eight small weight stores are retained, but only ONE multiplier is
    // reused across output-filter, input-channel and kernel-tap dimensions.
    wire [63:0] m0_w11,m0_w12,m0_w13,m0_w21,m0_w22,m0_w23,m0_w31,m0_w32,m0_w33;
    wire [63:0] m1_w11,m1_w12,m1_w13,m1_w21,m1_w22,m1_w23,m1_w31,m1_w32,m1_w33;
    wire [63:0] m2_w11,m2_w12,m2_w13,m2_w21,m2_w22,m2_w23,m2_w31,m2_w32,m2_w33;
    wire [63:0] m3_w11,m3_w12,m3_w13,m3_w21,m3_w22,m3_w23,m3_w31,m3_w32,m3_w33;
    wire [63:0] m4_w11,m4_w12,m4_w13,m4_w21,m4_w22,m4_w23,m4_w31,m4_w32,m4_w33;
    wire [63:0] m5_w11,m5_w12,m5_w13,m5_w21,m5_w22,m5_w23,m5_w31,m5_w32,m5_w33;
    wire [63:0] m6_w11,m6_w12,m6_w13,m6_w21,m6_w22,m6_w23,m6_w31,m6_w32,m6_w33;
    wire [63:0] m7_w11,m7_w12,m7_w13,m7_w21,m7_w22,m7_w23,m7_w31,m7_w32,m7_w33;

    `include "layer2_biases.vh"

    layer2_weight_manager #(.HEX_FILE("weights_mac0.hex")) ldr0 (clk,reset_n,load_en,pass_number,m0_w11,m0_w12,m0_w13,m0_w21,m0_w22,m0_w23,m0_w31,m0_w32,m0_w33);
    layer2_weight_manager #(.HEX_FILE("weights_mac1.hex")) ldr1 (clk,reset_n,load_en,pass_number,m1_w11,m1_w12,m1_w13,m1_w21,m1_w22,m1_w23,m1_w31,m1_w32,m1_w33);
    layer2_weight_manager #(.HEX_FILE("weights_mac2.hex")) ldr2 (clk,reset_n,load_en,pass_number,m2_w11,m2_w12,m2_w13,m2_w21,m2_w22,m2_w23,m2_w31,m2_w32,m2_w33);
    layer2_weight_manager #(.HEX_FILE("weights_mac3.hex")) ldr3 (clk,reset_n,load_en,pass_number,m3_w11,m3_w12,m3_w13,m3_w21,m3_w22,m3_w23,m3_w31,m3_w32,m3_w33);
    layer2_weight_manager #(.HEX_FILE("weights_mac4.hex")) ldr4 (clk,reset_n,load_en,pass_number,m4_w11,m4_w12,m4_w13,m4_w21,m4_w22,m4_w23,m4_w31,m4_w32,m4_w33);
    layer2_weight_manager #(.HEX_FILE("weights_mac5.hex")) ldr5 (clk,reset_n,load_en,pass_number,m5_w11,m5_w12,m5_w13,m5_w21,m5_w22,m5_w23,m5_w31,m5_w32,m5_w33);
    layer2_weight_manager #(.HEX_FILE("weights_mac6.hex")) ldr6 (clk,reset_n,load_en,pass_number,m6_w11,m6_w12,m6_w13,m6_w21,m6_w22,m6_w23,m6_w31,m6_w32,m6_w33);
    layer2_weight_manager #(.HEX_FILE("weights_mac7.hex")) ldr7 (clk,reset_n,load_en,pass_number,m7_w11,m7_w12,m7_w13,m7_w21,m7_w22,m7_w23,m7_w31,m7_w32,m7_w33);

    reg busy;
    reg [2:0] filter_idx;
    reg [2:0] input_ch;
    reg [3:0] tap_idx;
    reg signed [31:0] accumulator;

    reg [63:0] rp11,rp12,rp13,rp21,rp22,rp23,rp31,rp32,rp33;

    reg [63:0] pixel_word_sel;
    reg [63:0] weight_word_sel;
    reg signed [31:0] bias_sel;

    always @(*) begin
        case(tap_idx)
            0: pixel_word_sel=rp11; 1: pixel_word_sel=rp12; 2: pixel_word_sel=rp13;
            3: pixel_word_sel=rp21; 4: pixel_word_sel=rp22; 5: pixel_word_sel=rp23;
            6: pixel_word_sel=rp31; 7: pixel_word_sel=rp32; default: pixel_word_sel=rp33;
        endcase

        weight_word_sel = 64'd0;
        bias_sel = 32'sd0;
        case(filter_idx)
            3'd0: begin
                bias_sel = pass_number ? l2_m0_b1 : l2_m0_b0;
                case(tap_idx) 0:weight_word_sel=m0_w11;1:weight_word_sel=m0_w12;2:weight_word_sel=m0_w13;3:weight_word_sel=m0_w21;4:weight_word_sel=m0_w22;5:weight_word_sel=m0_w23;6:weight_word_sel=m0_w31;7:weight_word_sel=m0_w32;default:weight_word_sel=m0_w33; endcase
            end
            3'd1: begin
                bias_sel = pass_number ? l2_m1_b1 : l2_m1_b0;
                case(tap_idx) 0:weight_word_sel=m1_w11;1:weight_word_sel=m1_w12;2:weight_word_sel=m1_w13;3:weight_word_sel=m1_w21;4:weight_word_sel=m1_w22;5:weight_word_sel=m1_w23;6:weight_word_sel=m1_w31;7:weight_word_sel=m1_w32;default:weight_word_sel=m1_w33; endcase
            end
            3'd2: begin
                bias_sel = pass_number ? l2_m2_b1 : l2_m2_b0;
                case(tap_idx) 0:weight_word_sel=m2_w11;1:weight_word_sel=m2_w12;2:weight_word_sel=m2_w13;3:weight_word_sel=m2_w21;4:weight_word_sel=m2_w22;5:weight_word_sel=m2_w23;6:weight_word_sel=m2_w31;7:weight_word_sel=m2_w32;default:weight_word_sel=m2_w33; endcase
            end
            3'd3: begin
                bias_sel = pass_number ? l2_m3_b1 : l2_m3_b0;
                case(tap_idx) 0:weight_word_sel=m3_w11;1:weight_word_sel=m3_w12;2:weight_word_sel=m3_w13;3:weight_word_sel=m3_w21;4:weight_word_sel=m3_w22;5:weight_word_sel=m3_w23;6:weight_word_sel=m3_w31;7:weight_word_sel=m3_w32;default:weight_word_sel=m3_w33; endcase
            end
            3'd4: begin
                bias_sel = pass_number ? l2_m4_b1 : l2_m4_b0;
                case(tap_idx) 0:weight_word_sel=m4_w11;1:weight_word_sel=m4_w12;2:weight_word_sel=m4_w13;3:weight_word_sel=m4_w21;4:weight_word_sel=m4_w22;5:weight_word_sel=m4_w23;6:weight_word_sel=m4_w31;7:weight_word_sel=m4_w32;default:weight_word_sel=m4_w33; endcase
            end
            3'd5: begin
                bias_sel = pass_number ? l2_m5_b1 : l2_m5_b0;
                case(tap_idx) 0:weight_word_sel=m5_w11;1:weight_word_sel=m5_w12;2:weight_word_sel=m5_w13;3:weight_word_sel=m5_w21;4:weight_word_sel=m5_w22;5:weight_word_sel=m5_w23;6:weight_word_sel=m5_w31;7:weight_word_sel=m5_w32;default:weight_word_sel=m5_w33; endcase
            end
            3'd6: begin
                bias_sel = pass_number ? l2_m6_b1 : l2_m6_b0;
                case(tap_idx) 0:weight_word_sel=m6_w11;1:weight_word_sel=m6_w12;2:weight_word_sel=m6_w13;3:weight_word_sel=m6_w21;4:weight_word_sel=m6_w22;5:weight_word_sel=m6_w23;6:weight_word_sel=m6_w31;7:weight_word_sel=m6_w32;default:weight_word_sel=m6_w33; endcase
            end
            default: begin
                bias_sel = pass_number ? l2_m7_b1 : l2_m7_b0;
                case(tap_idx) 0:weight_word_sel=m7_w11;1:weight_word_sel=m7_w12;2:weight_word_sel=m7_w13;3:weight_word_sel=m7_w21;4:weight_word_sel=m7_w22;5:weight_word_sel=m7_w23;6:weight_word_sel=m7_w31;7:weight_word_sel=m7_w32;default:weight_word_sel=m7_w33; endcase
            end
        endcase
    end

    wire [7:0] pixel_sel = pixel_word_sel[(input_ch*8) +: 8];
    wire signed [7:0] weight_sel = weight_word_sel[(input_ch*8) +: 8];
    wire signed [16:0] product = $signed({1'b0,pixel_sel}) * weight_sel;
    wire signed [31:0] product_ext = {{15{product[16]}},product};
    wire signed [31:0] final_sum = accumulator + product_ext + bias_sel;
    wire signed [31:0] shifted = final_sum >>> SHIFT;

    assign mac_busy = busy;

    always @(posedge clk or negedge reset_n) begin
        if(!reset_n) begin
            busy<=0; mac_valid<=0; filter_idx<=0; input_ch<=0; tap_idx<=0; accumulator<=0;
            ch0<=0;ch1<=0;ch2<=0;ch3<=0;ch4<=0;ch5<=0;ch6<=0;ch7<=0;
            rp11<=0;rp12<=0;rp13<=0;rp21<=0;rp22<=0;rp23<=0;rp31<=0;rp32<=0;rp33<=0;
        end else begin
            mac_valid <= 1'b0;

            if(start && !busy) begin
                rp11<=p11;rp12<=p12;rp13<=p13;
                rp21<=p21;rp22<=p22;rp23<=p23;
                rp31<=p31;rp32<=p32;rp33<=p33;
                filter_idx<=0;
                input_ch<=0;
                tap_idx<=0;
                accumulator<=0;
                busy<=1'b1;
            end else if(busy) begin
                if(tap_idx == 4'd8) begin
                    if(input_ch == 3'd7) begin
                        // Last multiply for this output filter.
                        case(filter_idx)
                            3'd0: ch0 <= (final_sum < 0) ? 8'd0 : ((shifted > 255) ? 8'd255 : shifted[7:0]);
                            3'd1: ch1 <= (final_sum < 0) ? 8'd0 : ((shifted > 255) ? 8'd255 : shifted[7:0]);
                            3'd2: ch2 <= (final_sum < 0) ? 8'd0 : ((shifted > 255) ? 8'd255 : shifted[7:0]);
                            3'd3: ch3 <= (final_sum < 0) ? 8'd0 : ((shifted > 255) ? 8'd255 : shifted[7:0]);
                            3'd4: ch4 <= (final_sum < 0) ? 8'd0 : ((shifted > 255) ? 8'd255 : shifted[7:0]);
                            3'd5: ch5 <= (final_sum < 0) ? 8'd0 : ((shifted > 255) ? 8'd255 : shifted[7:0]);
                            3'd6: ch6 <= (final_sum < 0) ? 8'd0 : ((shifted > 255) ? 8'd255 : shifted[7:0]);
                            default: ch7 <= (final_sum < 0) ? 8'd0 : ((shifted > 255) ? 8'd255 : shifted[7:0]);
                        endcase

                        if(filter_idx == 3'd7) begin
                            busy<=1'b0;
                            mac_valid<=1'b1;
                            filter_idx<=0;
                            input_ch<=0;
                            tap_idx<=0;
                            accumulator<=0;
                        end else begin
                            filter_idx<=filter_idx+1'b1;
                            input_ch<=0;
                            tap_idx<=0;
                            accumulator<=0;
                        end
                    end else begin
                        accumulator <= accumulator + product_ext;
                        input_ch <= input_ch + 1'b1;
                        tap_idx <= 0;
                    end
                end else begin
                    accumulator <= accumulator + product_ext;
                    tap_idx <= tap_idx + 1'b1;
                end
            end
        end
    end
endmodule

// ----------------------------------------------------------------------------
// Layer-2 direct-window controller.
// Reads a 3x3x8 window from the 32x32 Ping RAM, then holds it while the eight
// Layer-2 output filters process channels 0..7 serially.
// ----------------------------------------------------------------------------
module layer2_controller (
    input wire clk,
    input wire reset_n,
    input wire start,
    output reg done,

    output reg load_en,
    output reg pass_number,

    output wire ping_re,
    output wire [9:0] ping_addr,
    input wire [63:0] ping_data,

    output reg mac_start,
    output reg [63:0] p11,p12,p13,p21,p22,p23,p31,p32,p33,
    input wire mac_valid,

    output wire pong_we,
    output wire [8:0] pong_addr
);
    localparam S_IDLE      = 3'd0;
    localparam S_LOAD      = 3'd1;
    localparam S_READ_REQ  = 3'd2;
    localparam S_READ_WAIT = 3'd3;
    localparam S_MAC       = 3'd4;
    localparam S_WAIT_MAC  = 3'd5;

    reg [2:0] state;
    reg [3:0] load_counter;
    reg [4:0] out_x, out_y;
    reg [3:0] read_index;

    reg signed [7:0] src_x, src_y;
    reg               coord_valid;

    always @(*) begin
        case (read_index)
            4'd0: begin src_x = ($signed({1'b0,out_x}) <<< 1) - 1; src_y = ($signed({1'b0,out_y}) <<< 1) - 1; end
            4'd1: begin src_x = ($signed({1'b0,out_x}) <<< 1);     src_y = ($signed({1'b0,out_y}) <<< 1) - 1; end
            4'd2: begin src_x = ($signed({1'b0,out_x}) <<< 1) + 1; src_y = ($signed({1'b0,out_y}) <<< 1) - 1; end
            4'd3: begin src_x = ($signed({1'b0,out_x}) <<< 1) - 1; src_y = ($signed({1'b0,out_y}) <<< 1);     end
            4'd4: begin src_x = ($signed({1'b0,out_x}) <<< 1);     src_y = ($signed({1'b0,out_y}) <<< 1);     end
            4'd5: begin src_x = ($signed({1'b0,out_x}) <<< 1) + 1; src_y = ($signed({1'b0,out_y}) <<< 1);     end
            4'd6: begin src_x = ($signed({1'b0,out_x}) <<< 1) - 1; src_y = ($signed({1'b0,out_y}) <<< 1) + 1; end
            4'd7: begin src_x = ($signed({1'b0,out_x}) <<< 1);     src_y = ($signed({1'b0,out_y}) <<< 1) + 1; end
            default: begin src_x = ($signed({1'b0,out_x}) <<< 1) + 1; src_y = ($signed({1'b0,out_y}) <<< 1) + 1; end
        endcase
        coord_valid = (src_x >= 0) && (src_x < 32) &&
                      (src_y >= 0) && (src_y < 32);
    end

    assign ping_re   = (state == S_READ_REQ) && coord_valid;
    assign ping_addr = coord_valid ? {src_y[4:0],src_x[4:0]} : 10'd0;

    assign pong_we   = (state == S_WAIT_MAC) && mac_valid;
    assign pong_addr = {pass_number,out_y[3:0],out_x[3:0]};

    always @(posedge clk or negedge reset_n) begin
        if (!reset_n) begin
            state       <= S_IDLE;
            done        <= 1'b0;
            load_en     <= 1'b0;
            pass_number <= 1'b0;
            mac_start   <= 1'b0;
            load_counter<= 0;
            out_x       <= 0;
            out_y       <= 0;
            read_index  <= 0;
            p11<=0;p12<=0;p13<=0;p21<=0;p22<=0;p23<=0;p31<=0;p32<=0;p33<=0;
        end else begin
            done      <= 1'b0;
            load_en   <= 1'b0;
            mac_start <= 1'b0;

            case (state)
                S_IDLE: begin
                    if (start) begin
                        pass_number  <= 1'b0;
                        load_counter <= 0;
                        state        <= S_LOAD;
                    end
                end

                S_LOAD: begin
                    load_en <= 1'b1;
                    if (load_counter == 8) begin
                        load_counter <= 0;
                        out_x        <= 0;
                        out_y        <= 0;
                        read_index   <= 0;
                        state        <= S_READ_REQ;
                    end else begin
                        load_counter <= load_counter + 1'b1;
                    end
                end

                S_READ_REQ: begin
                    if (coord_valid) begin
                        state <= S_READ_WAIT;
                    end else begin
                        case (read_index)
                            4'd0: p11 <= 64'd0;
                            4'd1: p12 <= 64'd0;
                            4'd2: p13 <= 64'd0;
                            4'd3: p21 <= 64'd0;
                            4'd4: p22 <= 64'd0;
                            4'd5: p23 <= 64'd0;
                            4'd6: p31 <= 64'd0;
                            4'd7: p32 <= 64'd0;
                            default: p33 <= 64'd0;
                        endcase

                        if (read_index == 8)
                            state <= S_MAC;
                        else
                            read_index <= read_index + 1'b1;
                    end
                end

                S_READ_WAIT: begin
                    case (read_index)
                        4'd0: p11 <= ping_data;
                        4'd1: p12 <= ping_data;
                        4'd2: p13 <= ping_data;
                        4'd3: p21 <= ping_data;
                        4'd4: p22 <= ping_data;
                        4'd5: p23 <= ping_data;
                        4'd6: p31 <= ping_data;
                        4'd7: p32 <= ping_data;
                        default: p33 <= ping_data;
                    endcase

                    if (read_index == 8) begin
                        state <= S_MAC;
                    end else begin
                        read_index <= read_index + 1'b1;
                        state <= S_READ_REQ;
                    end
                end

                S_MAC: begin
                    mac_start <= 1'b1;
                    state <= S_WAIT_MAC;
                end

                S_WAIT_MAC: begin
                    if (mac_valid) begin
                        if ((out_x == 15) && (out_y == 15)) begin
                            if (pass_number == 1'b0) begin
                                pass_number  <= 1'b1;
                                load_counter <= 0;
                                out_x        <= 0;
                                out_y        <= 0;
                                read_index   <= 0;
                                state        <= S_LOAD;
                            end else begin
                                state <= S_IDLE;
                                done  <= 1'b1;
                            end
                        end else if (out_x == 15) begin
                            out_x      <= 0;
                            out_y      <= out_y + 1'b1;
                            read_index <= 0;
                            state      <= S_READ_REQ;
                        end else begin
                            out_x      <= out_x + 1'b1;
                            read_index <= 0;
                            state      <= S_READ_REQ;
                        end
                    end
                end

                default: state <= S_IDLE;
            endcase
        end
    end
endmodule

// ----------------------------------------------------------------------------
// Pong RAM: 512 x 64-bit
// ----------------------------------------------------------------------------
module pong_ram_fixed (
    input wire clk,
    input wire we,
    input wire [8:0] write_addr,
    input wire [7:0] ch0_in,ch1_in,ch2_in,ch3_in,ch4_in,ch5_in,ch6_in,ch7_in,
    input wire re,
    input wire [8:0] read_addr,
    output reg [63:0] read_data
);
    (* ramstyle = "M10K" *) reg [63:0] memory [0:511];
    wire [63:0] packed_write_data = {ch7_in,ch6_in,ch5_in,ch4_in,ch3_in,ch2_in,ch1_in,ch0_in};

    always @(posedge clk) begin
        if (we)
            memory[write_addr] <= packed_write_data;
        if (re)
            read_data <= memory[read_addr];
    end
endmodule

// ----------------------------------------------------------------------------
// FC / Argmax.
// Weight ROM is an externally generated Quartus memory IP using
// weights_linear.mif.
// ----------------------------------------------------------------------------
module linear_classifier_fixed (
    input  wire clk,
    input  wire reset_n,
    input  wire layer2_done,
    output reg  cnn_done,
    output reg  [5:0] predicted_class,

    output reg  pong_re,
    output reg  [8:0] pong_addr,
    input  wire [63:0] pong_data,

    output reg  rom_re,
    output reg  [14:0] rom_addr,
    input  wire [63:0] rom_data
);
    // Serial FC engine: one 8x8 multiplier is reused for all 4096 features.
    // This preserves the exact integer score used for argmax, only taking more
    // clock cycles. At 50 MHz it is still only a few milliseconds/inference.
    localparam S_IDLE  = 3'd0;
    localparam S_INIT  = 3'd1;
    localparam S_REQ   = 3'd2;
    localparam S_WAIT1 = 3'd3;
    localparam S_WAIT2 = 3'd4;
    localparam S_MAC   = 3'd5;
	 localparam S_WAIT3 = 3'd6;

    reg [2:0] state;
    reg [5:0] class_idx;
    reg [8:0] spatial_idx;
    reg [2:0] byte_idx;

    reg [63:0] feature_word;
    reg [63:0] weight_word;

    reg signed [31:0] accumulator;
    reg signed [31:0] max_score;
    reg have_max;

    wire [5:0] active_class = class_idx;
    reg signed [31:0] current_bias;
    `include "linear_bias.vh"

    wire [7:0] feature_sel = feature_word[(byte_idx*8) +: 8];
    wire signed [7:0] weight_sel = weight_word[(byte_idx*8) +: 8];
    wire signed [16:0] product = $signed({1'b0,feature_sel}) * weight_sel;
    wire signed [31:0] product_ext = {{15{product[16]}}, product};
    wire signed [31:0] final_score = accumulator + product_ext;

    always @(posedge clk or negedge reset_n) begin
        if(!reset_n) begin
            state<=S_IDLE;
            class_idx<=0;
            spatial_idx<=0;
            byte_idx<=0;
            feature_word<=0;
            weight_word<=0;
            accumulator<=0;
            max_score<=0;
            have_max<=0;
            predicted_class<=0;
            cnn_done<=0;
            pong_re<=0;
            pong_addr<=0;
            rom_re<=0;
            rom_addr<=0;
        end else begin
            cnn_done <= 1'b0;
            pong_re  <= 1'b0;
            rom_re   <= 1'b0;

            case(state)
                S_IDLE: begin
                    if(layer2_done) begin
                        class_idx<=0;
                        spatial_idx<=0;
                        byte_idx<=0;
                        max_score<=0;
                        have_max<=0;
                        predicted_class<=0;
                        state<=S_INIT;
                    end
                end

                S_INIT: begin
                    // current_bias is combinationally selected by class_idx.
                    accumulator <= current_bias;
                    spatial_idx <= 0;
                    byte_idx <= 0;
                    state <= S_REQ;
                end

                S_REQ: begin
                    pong_re   <= 1'b1;
                    rom_re    <= 1'b1;
                    pong_addr <= spatial_idx;
                    rom_addr  <= {class_idx,9'b0} + spatial_idx;
                    state     <= S_WAIT1;
                end

                // The Ping/Pong RAM and Quartus FC ROM are synchronous. The
                // extra wait stage makes the design tolerant of the registered
                // read used by the supplied memory modules/IP.
						S_WAIT1: begin
							 state <= S_WAIT2;
						end

						S_WAIT2: begin
							 state <= S_WAIT3;
						end

						S_WAIT3: begin
							 feature_word <= pong_data;
							 weight_word  <= rom_data;
							 byte_idx     <= 0;
							 state        <= S_MAC;
						end

                S_MAC: begin
                    if(byte_idx == 3'd7) begin
                        if(spatial_idx == 9'd511) begin
                            // Last of 4096 features for this class.
                            if(!have_max || final_score > max_score) begin
                                max_score <= final_score;
                                predicted_class <= class_idx;
                                have_max <= 1'b1;
                            end

                            if(class_idx == 6'd53) begin
                                cnn_done <= 1'b1;
                                state <= S_IDLE;
                            end else begin
                                class_idx <= class_idx + 1'b1;
                                state <= S_INIT;
                            end
                        end else begin
                            accumulator <= accumulator + product_ext;
                            spatial_idx <= spatial_idx + 1'b1;
                            byte_idx <= 0;
                            state <= S_REQ;
                        end
                    end else begin
                        accumulator <= accumulator + product_ext;
                        byte_idx <= byte_idx + 1'b1;
                    end
                end

                default: state <= S_IDLE;
            endcase
        end
    end
endmodule

// ----------------------------------------------------------------------------
// CNN top used by the supplied DE10_Nano_D8M_DDR3 board top.
// ----------------------------------------------------------------------------
module cnn_accelerator_top (
 input wire clk_50mhz,reset_n,
 input wire pixel_clear,pixel_we,
 input wire [11:0] pixel_addr,
 input wire [7:0] pixel_data,
 input wire start,
 input wire bbox_valid,
 input wire [10:0] bbox_min_x,bbox_max_x,bbox_min_y,bbox_max_y,
 output wire [5:0] predicted_class,
 output wire cnn_done,
 output reg busy,
 output reg [31:0] image_hash,
 output reg [12:0] image_count,
 output reg result_bbox_valid,
 output reg [10:0] result_bbox_min_x,result_bbox_max_x,result_bbox_min_y,result_bbox_max_y
);
 `include "cnn_quant_config.vh"
 wire start_accepted=start && !busy && image_count==4096;
 wire crop_re;
 wire [11:0] crop_read_addr;
 wire [7:0] crop_read_data;
 wire accepted_we=pixel_we && !busy;
 // Preserve the original registered BRAM read latency used by layer 1.
 cropper_bram u_image_ram (
  .clk_camera(clk_50mhz),.we(accepted_we),.write_addr(pixel_addr),.write_data(pixel_data),
  .clk_cnn(clk_50mhz),.re(crop_re),.read_addr(crop_read_addr),.read_data(crop_read_data)
 );
 always @(posedge clk_50mhz or negedge reset_n)begin
  if(!reset_n)begin
   image_hash<=0;image_count<=0;result_bbox_valid<=0;
   result_bbox_min_x<=0;result_bbox_max_x<=0;result_bbox_min_y<=0;result_bbox_max_y<=0;
  end else begin
   if(pixel_clear && !busy)begin image_hash<=0;image_count<=0;end
   else if(accepted_we)begin
    image_hash<={image_hash[26:0],image_hash[31:27]} ^ {24'd0,pixel_data};
    image_count<=image_count+1'b1;
   end
   if(start_accepted)begin
    result_bbox_valid<=bbox_valid;
    result_bbox_min_x<=bbox_min_x;result_bbox_max_x<=bbox_max_x;
    result_bbox_min_y<=bbox_min_y;result_bbox_max_y<=bbox_max_y;
   end
  end
 end
    // ------------------------------------------------------------------------
    // Layer 1 / Layer 2 interconnect declarations
    // ------------------------------------------------------------------------
    wire l1_done;
    wire l2_load_en, l2_pass_num;
    wire l2_ping_re;
    wire [9:0] l2_ping_addr;
    wire [63:0] ping_to_l2_data;
    wire l1_mac_start;
    wire l1_mac_valid;
    wire [7:0] l1_p11,l1_p12,l1_p13,l1_p21,l1_p22,l1_p23,l1_p31,l1_p32,l1_p33;
    wire [7:0] l1_ch0,l1_ch1,l1_ch2,l1_ch3,l1_ch4,l1_ch5,l1_ch6,l1_ch7;
    wire l1_ping_we;
    wire [9:0] l1_ping_addr;

    layer1_controller u_l1_controller (
        .clk(clk_50mhz),
        .reset_n(reset_n),
        .start(start_accepted),
        .done(l1_done),
        .bram_en(crop_re),
        .bram_addr(crop_read_addr),
        .bram_data(crop_read_data),
        .mac_start(l1_mac_start),
        .p11(l1_p11),.p12(l1_p12),.p13(l1_p13),
        .p21(l1_p21),.p22(l1_p22),.p23(l1_p23),
        .p31(l1_p31),.p32(l1_p32),.p33(l1_p33),
        .mac_valid(l1_mac_valid),
        .ping_we(l1_ping_we),
        .ping_addr(l1_ping_addr)
    );

    layer1_mac_bank #(.SHIFT(L1_SHIFT)) u_l1_bank (
        .clk(clk_50mhz),
        .reset_n(reset_n),
        .start(l1_mac_start),
        .p11(l1_p11),.p12(l1_p12),.p13(l1_p13),
        .p21(l1_p21),.p22(l1_p22),.p23(l1_p23),
        .p31(l1_p31),.p32(l1_p32),.p33(l1_p33),
        .ch0(l1_ch0),.ch1(l1_ch1),.ch2(l1_ch2),.ch3(l1_ch3),
        .ch4(l1_ch4),.ch5(l1_ch5),.ch6(l1_ch6),.ch7(l1_ch7),
        .valid_out(l1_mac_valid)
    );

    ping_ram_fixed u_ping_ram (
        .clk(clk_50mhz),
        .we(l1_ping_we),
        .write_addr(l1_ping_addr),
        .ch0_in(l1_ch0),.ch1_in(l1_ch1),.ch2_in(l1_ch2),.ch3_in(l1_ch3),
        .ch4_in(l1_ch4),.ch5_in(l1_ch5),.ch6_in(l1_ch6),.ch7_in(l1_ch7),
        .re(l2_ping_re),
        .read_addr(l2_ping_addr),
        .read_data(ping_to_l2_data)
    );

    // ------------------------------------------------------------------------
    // Layer 2
    // ------------------------------------------------------------------------
    wire l2_done;
    wire l2_mac_start;
    wire l2_mac_valid;
    wire [63:0] l2_p11,l2_p12,l2_p13,l2_p21,l2_p22,l2_p23,l2_p31,l2_p32,l2_p33;
    wire l2_pong_we;
    wire [8:0] l2_pong_addr;
    wire [7:0] l2_ch0,l2_ch1,l2_ch2,l2_ch3,l2_ch4,l2_ch5,l2_ch6,l2_ch7;

    layer2_controller u_l2_controller (
        .clk(clk_50mhz),
        .reset_n(reset_n),
        .start(l1_done),
        .done(l2_done),
        .load_en(l2_load_en),
        .pass_number(l2_pass_num),
        .ping_re(l2_ping_re),
        .ping_addr(l2_ping_addr),
        .ping_data(ping_to_l2_data),
        .mac_start(l2_mac_start),
        .p11(l2_p11),.p12(l2_p12),.p13(l2_p13),
        .p21(l2_p21),.p22(l2_p22),.p23(l2_p23),
        .p31(l2_p31),.p32(l2_p32),.p33(l2_p33),
        .mac_valid(l2_mac_valid),
        .pong_we(l2_pong_we),
        .pong_addr(l2_pong_addr)
    );

    layer2_mac_bank #(.SHIFT(L2_SHIFT)) u_l2_bank (
        .clk(clk_50mhz),
        .reset_n(reset_n),
        .load_en(l2_load_en),
        .pass_number(l2_pass_num),
        .start(l2_mac_start),
        .p11(l2_p11),.p12(l2_p12),.p13(l2_p13),
        .p21(l2_p21),.p22(l2_p22),.p23(l2_p23),
        .p31(l2_p31),.p32(l2_p32),.p33(l2_p33),
        .ch0(l2_ch0),.ch1(l2_ch1),.ch2(l2_ch2),.ch3(l2_ch3),
        .ch4(l2_ch4),.ch5(l2_ch5),.ch6(l2_ch6),.ch7(l2_ch7),
        .mac_valid(l2_mac_valid),
        .mac_busy()
    );

    // ------------------------------------------------------------------------
    // Pong RAM + FC
    // ------------------------------------------------------------------------
    wire lin_pong_re;
    wire [8:0] lin_pong_addr;
    wire [63:0] pong_to_lin_data;
    wire lin_rom_re;
    wire [14:0] lin_rom_addr;
    wire [63:0] lin_rom_data;

    pong_ram_fixed u_pong_ram (
        .clk(clk_50mhz),
        .we(l2_pong_we),
        .write_addr(l2_pong_addr),
        .ch0_in(l2_ch0),.ch1_in(l2_ch1),.ch2_in(l2_ch2),.ch3_in(l2_ch3),
        .ch4_in(l2_ch4),.ch5_in(l2_ch5),.ch6_in(l2_ch6),.ch7_in(l2_ch7),
        .re(lin_pong_re),
        .read_addr(lin_pong_addr),
        .read_data(pong_to_lin_data)
    );

    // Configure this Quartus memory IP with weights_linear.mif.
    // It must expose: clock, address, q. No read-enable is required.
    linear_weight_rom u_fc_rom (
        .clock(clk_50mhz),
        .address(lin_rom_addr),
        .q(lin_rom_data)
    );

    linear_classifier_fixed u_linear (
        .clk(clk_50mhz),
        .reset_n(reset_n),
        .layer2_done(l2_done),
        .cnn_done(cnn_done),
        .predicted_class(predicted_class),
        .pong_re(lin_pong_re),
        .pong_addr(lin_pong_addr),
        .pong_data(pong_to_lin_data),
        .rom_re(lin_rom_re),
        .rom_addr(lin_rom_addr),
        .rom_data(lin_rom_data)
    );

    // ------------------------------------------------------------------------
    // Whole-inference busy flag. It is deliberately kept high from the
    // synchronized frame-ready event until FC argmax is finished.
    // ------------------------------------------------------------------------
    always @(posedge clk_50mhz or negedge reset_n) begin
        if (!reset_n) begin
            busy <= 1'b0;
        end else begin
            if (start_accepted)
                busy <= 1'b1;
            else if (cnn_done)
                busy <= 1'b0;
        end
    end
endmodule

`default_nettype wire
